@model ApartmentManagementSystem.Models.EntryLog

@{
    ViewData["Title"] = "Create Entry Log";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0">
                <div class="card-header py-3 bg-brand-gradient text-white text-center">
                    <h5 class="mb-0">
                        <i class="fas fa-user-plus me-2"></i>
                        Create New Entry
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" id="entryLogForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Fullname" class="form-control" placeholder="Full Name" required />
                                    <label asp-for="Fullname" class="form-label">
                                        <i class="fas fa-user me-1"></i>Full Name
                                    </label>
                                    <span asp-validation-for="Fullname" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
                                    <label asp-for="PhoneNumber" class="form-label">
                                        <i class="fas fa-phone me-1"></i>Phone Number
                                    </label>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="BuildingId" class="form-select" asp-items="ViewBag.BuildingId" required onchange="loadFlats()">
                                        <option value="">Select Building</option>
                                    </select>
                                    <label asp-for="BuildingId" class="form-label">
                                        <i class="fas fa-building me-1"></i>Building
                                    </label>
                                    <span asp-validation-for="BuildingId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="FlatId" class="form-select" required>
                                        <option value="">Select Flat</option>
                                        @if (ViewBag.FlatId != null)
                                        {
                                            @foreach (SelectListItem item in ViewBag.FlatId)
                                            {
                                                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                            }
                                        }
                                    </select>
                                    <label asp-for="FlatId" class="form-label">
                                        <i class="fas fa-door-closed me-1"></i>Flat
                                    </label>
                                    <span asp-validation-for="FlatId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="EntryType" class="form-select" required>
                                        <option value="">Select Entry Type</option>
                                        <option value="0">Visitor</option>
                                        <option value="1">Delivery</option>
                                        <option value="2">Teacher</option>
                                        <option value="3">Maintenance</option>
                                        <option value="4">Other</option>
                                    </select>
                                    <label asp-for="EntryType" class="form-label">
                                        <i class="fas fa-tag me-1"></i>Entry Type
                                    </label>
                                    <span asp-validation-for="EntryType" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="NumberOfPerson" type="number" class="form-control" placeholder="Number of Persons" min="1" max="20" value="1" required />
                                    <label asp-for="NumberOfPerson" class="form-label">
                                        <i class="fas fa-users me-1"></i>Number of Persons
                                    </label>
                                    <span asp-validation-for="NumberOfPerson" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Purpose" class="form-control" placeholder="Purpose of visit" rows="3" style="height: 100px" required></textarea>
                                    <label asp-for="Purpose" class="form-label">
                                        <i class="fas fa-clipboard me-1"></i>Purpose of Visit
                                    </label>
                                    <span asp-validation-for="Purpose" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="EntryTime" type="datetime-local" class="form-control" required />
                                    <label asp-for="EntryTime" class="form-label">
                                        <i class="fas fa-sign-in-alt me-1"></i>Entry Time
                                    </label>
                                    <span asp-validation-for="EntryTime" class="text-danger small"></span>
                                </div>
                                <small class="text-muted">Current time is set by default</small>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ExitTime" type="datetime-local" class="form-control" />
                                    <label asp-for="ExitTime" class="form-label">
                                        <i class="fas fa-sign-out-alt me-1"></i>Exit Time (Optional)
                                    </label>
                                    <span asp-validation-for="ExitTime" class="text-danger small"></span>
                                </div>
                                <small class="text-muted">Leave empty if visitor is still inside</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <hr class="my-4">
                                <div class="row">
                                    <div class="col col-md-6">
                                        <a asp-action="Index" class="btn btn-outline-secondary w-100">
                                            <i class="fas fa-times me-2"></i>Cancel
                                        </a>
                                    </div>
                                    <div class="col col-md-6">
                                        <button type="submit" class="btn btn-primary px-4 w-100">
                                            Create Entry Log
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .form-floating > .form-control:focus,
    .form-floating > .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    .border-bottom {
        border-color: #dee2e6 !important;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "›";
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const entryTimeInput = document.querySelector('input[name="EntryTime"]');
            if (entryTimeInput && !entryTimeInput.value) {
                setCurrentTime(entryTimeInput);
            }
        });

        function getCurrentTimeString() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            return `${year}-${month}-${day}T${hours}:${minutes}`;
        }

        function setCurrentTime(input) {
            input.value = getCurrentTimeString();
        }

        function getMaxDatetime() {
            return getCurrentTimeString();
        }

        function loadFlats() {
            const buildingId = document.getElementById('BuildingId').value;
            const flatSelect = document.getElementById('FlatId');

            flatSelect.innerHTML = '<option value="">Loading flats...</option>';

            if (!buildingId) {
                flatSelect.innerHTML = '<option value="">Select Building First</option>';
                return;
            }

            fetch(`/api/flats/bybuilding/${buildingId}`)
                .then(response => response.json())
                .then(data => {
                    flatSelect.innerHTML = '<option value="">Select Flat</option>';
                    data.forEach(flat => {
                        const option = document.createElement('option');
                        option.value = flat.id;
                        option.textContent = flat.flatNumber;
                        flatSelect.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error('Error loading flats:', error);
                    flatSelect.innerHTML = '<option value="">Error loading flats</option>';
                });
        }

        document.getElementById('entryLogForm').addEventListener('submit', function(e) {
            const requiredFields = this.querySelectorAll('[required]');
            let isValid = true;

            requiredFields.forEach(field => {
                if (!field.value || field.value.trim() === '') {
                    field.classList.add('is-invalid');
                    isValid = false;
                } else {
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                }
            });

            const entryTimeInput = document.querySelector('input[name="EntryTime"]');
            const entryTime = entryTimeInput.value;

            if (entryTime) {
                const entryDate = new Date(entryTime);
                const now = new Date();
                now.setSeconds(0, 0);

                if (entryDate > now) {
                    alert('Entry time cannot be in the future.');
                    entryTimeInput.classList.add('is-invalid');
                    e.preventDefault();
                    return;
                }
            }

            const exitTimeInput = document.querySelector('input[name="ExitTime"]');
            const exitTime = exitTimeInput.value;

            if (entryTime && exitTime) {
                const entryDate = new Date(entryTime);
                const exitDate = new Date(exitTime);

                if (exitDate <= entryDate) {
                    alert('Exit time must be after entry time.');
                    exitTimeInput.classList.add('is-invalid');
                    e.preventDefault();
                    return;
                }
            }

            if (!isValid) {
                e.preventDefault();
                alert('Please fill in all required fields.');
            }
        });

        document.querySelectorAll('input[required], select[required], textarea[required]').forEach(field => {
            field.addEventListener('blur', function() {
                if (this.value && this.value.trim()) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });
        });

        document.querySelector('input[name="EntryTime"]').addEventListener('change', function() {
            if (this.value) {
                const entryDate = new Date(this.value);
                const now = new Date();
                now.setSeconds(0, 0);

                if (entryDate > now) {
                    this.classList.add('is-invalid');
                    this.setCustomValidity('Entry time cannot be in the future');
                } else {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                    this.setCustomValidity('');
                }
            }
        });

        document.querySelector('input[name="ExitTime"]').addEventListener('change', function() {
            const entryTime = document.querySelector('input[name="EntryTime"]').value;
            if (this.value && entryTime) {
                const entryDate = new Date(entryTime);
                const exitDate = new Date(this.value);

                if (exitDate <= entryDate) {
                    this.classList.add('is-invalid');
                    this.setCustomValidity('Exit time must be after entry time');
                } else {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                    this.setCustomValidity('');
                }
            } else if (this.value) {
                this.classList.add('is-valid');
                this.setCustomValidity('');
            }
        });

        const phoneInput = document.querySelector('input[name="PhoneNumber"]');
        if (phoneInput) {
            phoneInput.addEventListener('input', function() {
                let value = this.value.replace(/\D/g, '');

                if (value.length > 11) {
                    this.value = value.substr(0, 11);
                } else {
                    this.value = value;
                }
            });
        }
    </script>
}