            <div class="col-6 col-md-3">
                <div class="badge-tile p-4 rounded-4 bg-white shadow-sm h-100 modern-hover">
                    <div class="icon-wrapper mb-3">
                        <i class="fas fa-users fs-2 text-secondary"></i>
                    </div>
                    <h6 class="fw-semibold mb-0">Tenants</h6>
                </div>
            </div>
            <div class="col-6 col-md-3">
