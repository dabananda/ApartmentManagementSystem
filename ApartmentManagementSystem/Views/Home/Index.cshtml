                        <p class="text-muted">Track maintenance tickets, vendors, and expenses with clear status updates.</p>
                        <ul class="small text-muted mb-0">
                            <li>Lifecycle statuses</li>
                            <li>Photo/file attachments</li>
                            <li>Vendor ledger</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
