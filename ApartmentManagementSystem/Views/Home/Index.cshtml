<!-- FAQ -->
<section id="faq" class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h2 class="text-center fw-bold mb-4">Frequently Asked Questions</h2>
                <div class="accordion" id="faqAcc">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="q1">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#a1">Can I disable public registration?</button>
                        </h2>
                        <div id="a1" class="accordion-collapse collapse show" data-bs-parent="#faqAcc">
                            <div class="accordion-body">Yes. Hide the Register button and restrict sign-ups to Super Admin approvals only.</div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="q2">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#a2">Does AMS work for multiple buildings?</button>
                        </h2>
                        <div id="a2" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                            <div class="accordion-body">Yes. Super Admin can create multiple buildings, units and assign Presidents.</div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="q3">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#a3">Is my data secure?</button>
                        </h2>
                        <div id="a3" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                            <div class="accordion-body">AMS uses ASP.NET Core Identity, claims-based access and follows best practices.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

