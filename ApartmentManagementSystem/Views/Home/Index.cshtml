@model ApartmentManagementSystem.ViewModels.Others.ContactViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Modern Living, Managed";
}

@if (TempData["ContactStatus"] as string == "sent")
{
    <div class="container mt-4">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            Thanks! Your message has been sent. We’ll get back to you shortly.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}
@if (TempData["ContactStatus"] as string == "error")
{
    <div class="container mt-4">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            Please fix the errors in the contact form and try again.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<!-- HERO -->
<section class="hero py-5">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-7">
                <div class="mb-4">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                        <i class="fas fa-rocket me-2"></i>
                        Modern Building Management
                    </span>
                </div>
                <h1 class="display-4 fw-bold mb-4">
                    Apartment Management
                    <span class="text-primary">System</span>
                </h1>
                <p class="lead mb-4 text-muted">
                    Streamline building operations with an all-in-one platform: billing, payments, tenants, visitors, and maintenance —
                    tailored dashboards for Super Admins, Presidents, Owners, and Tenants.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-primary btn-lg px-4 shadow-sm" href="/dashboard">
                            <i class="fas fa-tachometer-alt me-2"></i> Go to Dashboard
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-lg px-4 shadow-sm" asp-area="Identity" asp-page="/Account/Login">
                            <i class="fas fa-sign-in-alt me-2"></i> Login
                        </a>
                        <a class="btn btn-outline-primary btn-lg px-4" asp-area="Identity" asp-page="/Account/Register">
                            <i class="fas fa-user-plus me-2"></i> Register
                        </a>
                        <a class="btn btn-link text-decoration-none fw-medium" href="#features">
                            Explore Features <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    }
                </div>
                <div class="d-flex align-items-center gap-4 text-secondary small">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-shield-check me-2 text-success"></i> Secure Access
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-bolt me-2 text-warning"></i> Fast & Reliable
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-cloud me-2 text-info"></i> Cloud Ready
                    </div>
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <div class="hero-image-container">
                    <div class="floating-card">
                        <img src="https://res.cloudinary.com/djz3p8sux/image/upload/v1757825056/ams/64e28744-c8f4-48c3-959b-2a25f30920b8.png"
                             alt="AMS Preview" class="img-fluid rounded-4 shadow-lg" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Trust badges -->
        <div class="row text-center mt-5 g-4">
            <div class="col-6 col-md-3">
                <div class="badge-tile p-4 rounded-4 bg-white shadow-sm h-100 modern-hover">
                    <div class="icon-wrapper mb-3">
                        <i class="fas fa-credit-card fs-2 text-success"></i>
                    </div>
                    <h6 class="fw-semibold mb-0">Payments</h6>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="badge-tile p-4 rounded-4 bg-white shadow-sm h-100 modern-hover">
                    <div class="icon-wrapper mb-3">
                        <i class="fas fa-shield-alt fs-2 text-primary"></i>
                    </div>
                    <h6 class="fw-semibold mb-0">Security</h6>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="badge-tile p-4 rounded-4 bg-white shadow-sm h-100 modern-hover">
                    <div class="icon-wrapper mb-3">
                        <i class="fas fa-chart-line fs-2 text-info"></i>
                    </div>
                    <h6 class="fw-semibold mb-0">Reporting</h6>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="badge-tile p-4 rounded-4 bg-white shadow-sm h-100 modern-hover">
                    <div class="icon-wrapper mb-3">
                        <i class="fas fa-cogs fs-2 text-warning"></i>
                    </div>
                    <h6 class="fw-semibold mb-0">Admin Control</h6>
                </div>
            </div>
        </div>

        <!-- Additional badges row -->
