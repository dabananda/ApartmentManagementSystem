                        <ul class="small text-muted mb-0">
                            <li>Smart search & filters</li>
                            <li>Owner billing profiles</li>
                            <li>Move-in/out history</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
