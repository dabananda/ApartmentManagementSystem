<!-- CONTACT -->
<section id="contact" class="py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Contact form -->
            <div class="col-lg-6">
                <h2 class="fw-bold mb-2">Get in Touch</h2>
                <p class="text-muted">Questions, feedback, or requests? Send a message and we’ll reply soon.</p>
                <form asp-action="Contact" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Your Name</label>
                        <input asp-for="Name" class="form-control" required />
                        <span class="text-danger" asp-validation-for="Name"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" required />
                        <span class="text-danger" asp-validation-for="Email"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label">Subject</label>
                        <input asp-for="Subject" class="form-control" required />
                        <span class="text-danger" asp-validation-for="Subject"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Message" class="form-label">Message</label>
                        <textarea asp-for="Message" rows="5" class="form-control" required></textarea>
                        <span class="text-danger" asp-validation-for="Message"></span>
                    </div>
                    <button class="btn btn-primary btn-lg" type="submit">
                        <i class="bi bi-send me-1"></i> Send Message
                    </button>
                </form>
            </div>

            <!-- Google Map Location -->
            <div class="col-lg-6">
                <div class="p-4 bg-light rounded-3 h-100 border">
                    <h3 class="h5">Contact Details</h3>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><i class="bi bi-envelope me-2"></i> imdmitra@gmail.com</li>
                        <li class="mb-2"><i class="bi bi-whatsapp me-2"></i> +8801304080014</li>
                        <li class="mb-2"><i class="bi bi-geo-alt me-2"></i> Mirpur 13, Dhaka, Bangladesh</li>
                        @* <li class="mb-2"><i class="bi bi-clock me-2"></i> Sun – Thurs · 9am – 5pm</li> *@
                    </ul>
                    <div class="ratio ratio-16x9 rounded overflow-hidden shadow-sm">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1825.1552417194903!2d90.38184812928654!3d23.807555940720786!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3755c7285f7e6a75%3A0x14ddf7d3104a5602!2sInstitute%20of%20Science%20Trade%20%26%20Technology%20(ISTT)!5e0!3m2!1sen!2sbd!4v1757790071870!5m2!1sen!2sbd"
                                title="Map" loading="lazy"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Bootstrap client-side validation styling
        (function () {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}
