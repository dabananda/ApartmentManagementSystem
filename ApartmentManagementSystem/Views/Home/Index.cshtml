                        <ul class="small text-muted mb-0">
                            <li>KPIs by role</li>
                            <li>Trends & insights</li>
                            <li>Drill-downs to records</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
