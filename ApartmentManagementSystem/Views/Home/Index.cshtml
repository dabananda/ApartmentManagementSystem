@model ApartmentManagementSystem.ViewModels.Others.ContactViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Transform Your Apartment Management";
}

@if (TempData["ContactStatus"] as string == "sent")
{
    <div class="container mt-4">
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            Thanks! Your message has been sent. We'll get back to you shortly.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}
@if (TempData["ContactStatus"] as string == "error")
{
    <div class="container mt-4">
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Please fix the errors in the contact form and try again.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<section class="hero-modern overflow-hidden" id="home">
    <div class="hero-background"></div>
    <div class="container position-relative">
        <div class="row align-items-center min-vh-100 py-5">
            <div class="col-lg-6">
                <div class="hero-content">
                    <div class="badge bg-gradient-purple text-white px-3 py-2 rounded-pill mb-4 d-inline-block">
                        <i class="bi bi-star-fill me-1"></i>
                        #1 Apartment Management Platform
                    </div>
                    <h1 class="display-3 fw-bold mb-4 text-dark">
                        Transform Your
                        <span class="text-gradient-purple">Apartment Management</span>
                    </h1>
                    <p class="lead mb-5 text-muted fs-5">
                        Stop drowning in paperwork and spreadsheets. Our intelligent platform automates billing,
                        streamlines operations, and delights residents with transparency they've never experienced.
                    </p>

                    <div class="d-flex flex-wrap gap-3 mb-5">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-gradient-purple btn-lg px-5 py-3 shadow-lg" href="/dashboard">
                                <i class="bi bi-speedometer2 me-2"></i>
                                Go to Dashboard
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-gradient-purple btn-lg px-5 py-3 shadow-lg" asp-area="Identity" asp-page="/Account/Login">
                                <i class="bi bi-rocket-takeoff me-2"></i>
                                Start Free Today
                            </a>
                            <a class="btn btn-outline-purple btn-lg px-5 py-3" href="#demo">
                                <i class="bi bi-play-circle me-2"></i>
                                Watch Demo
                            </a>
                        }
                    </div>

                    <div class="stats-row d-flex flex-wrap gap-4 text-muted">
                        <div class="stat-item">
                            <div class="h4 fw-bold text-purple mb-0">500+</div>
                            <small>Buildings Managed</small>
                        </div>
                        <div class="stat-item">
                            <div class="h4 fw-bold text-purple mb-0">10k+</div>
                            <small>Happy Residents</small>
                        </div>
                        <div class="stat-item">
                            <div class="h4 fw-bold text-purple mb-0">95%</div>
                            <small>Time Saved</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image-container">
                    <div class="floating-card card-1">
                        <div class="card border-0 shadow-lg">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-circle bg-success">
                                        <i class="bi bi-cash-coin text-white"></i>
                                    </div>
                                    <div class="ms-3">
                                        <h6 class="mb-0 fw-semibold">Monthly Revenue</h6>
                                        <small class="text-muted">+23% this month</small>
                                    </div>
                                </div>
                                <div class="h4 fw-bold text-success mb-0">৳2,45,000</div>
                            </div>
                        </div>
                    </div>

                    <div class="floating-card card-2">
                        <div class="card border-0 shadow-lg">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-circle bg-purple">
                                        <i class="bi bi-people text-white"></i>
                                    </div>
                                    <div class="ms-3">
                                        <h6 class="mb-0 fw-semibold">Active Tenants</h6>
                                        <small class="text-muted">98% occupancy</small>
                                    </div>
                                </div>
                                <div class="h4 fw-bold text-purple mb-0">247</div>
                            </div>
                        </div>
                    </div>

                    <div class="hero-main-image">
                        <img src="https://res.cloudinary.com/djz3p8sux/image/upload/v1757825356/ams/15507d2d-0d1f-4ce8-b205-336ac3891dda.png"
                             alt="AMS Dashboard"
                             class="img-fluid rounded-4 shadow-xl">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

