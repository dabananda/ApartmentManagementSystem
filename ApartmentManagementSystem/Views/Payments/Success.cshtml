@model ApartmentManagementSystem.Application.Features.Payments.DTOs.CheckoutResultVm
@{
    ViewData["Title"] = "Payment successful";
}

<div class="card mt-4">
    <div class="card-body">
        <h3 class="card-title">? Payment completed</h3>
        @if (Model is null)
        {
            <p class="text-muted">Your payment session completed, but we couldn’t load details.</p>
        }
        else
        {
            <p>Thanks! We’ve received confirmation from Stripe.</p>
            <dl class="row">
                <dt class="col-sm-3">Amount</dt>
                <dd class="col-sm-9">@((Model.Amount).ToString("C")) @Model.Currency</dd>

                @if (!string.IsNullOrWhiteSpace(Model.Status))
                {
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@Model.Status</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PaymentIntentId))
                {
                    <dt class="col-sm-3">Payment Intent</dt>
                    <dd class="col-sm-9"><code>@Model.PaymentIntentId</code></dd>
                }

                <dt class="col-sm-3">Session</dt>
                <dd class="col-sm-9"><code>@Model.SessionId</code></dd>
            </dl>
        }

        <div class="alert alert-info mt-3">
            <strong>Note:</strong> The official payment record is stored via a secure Stripe <em>webhook</em>.
            If your records don’t appear instantly, make sure the webhook is configured (see instructions below).
        </div>

        <a asp-controller="TenantPortal" asp-action="Bills" class="btn btn-primary me-2">Back to my bills</a>
        <a asp-controller="OwnerBilling" asp-action="View" class="btn btn-outline-secondary">Owner billing</a>
    </div>
</div>
