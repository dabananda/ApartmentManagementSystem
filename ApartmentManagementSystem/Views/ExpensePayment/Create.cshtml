@model ApartmentManagementSystem.Models.ExpensePayment

@{
    ViewData["Title"] = "Record New Payment";
}

<div class="row">
    <div class="col-md-5 mx-auto">
        <div class="card">
            <div class="card-header text-center py-3 bg-brand-gradient text-light">
                <h4 class="card-title>">Record New Expense</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="BuildingId" value="@ViewData["BuildingId"]" />

                    <div class="form-group mb-3">
                        <label asp-for="CommonBillId" class="control-label mb-1"></label>
                        <select asp-for="CommonBillId" class="form-control" asp-items="ViewBag.CommonBillId"></select>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Name" class="control-label mb-1"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="PaymentDate" class="control-label mb-1"></label>
                        <input asp-for="PaymentDate" class="form-control" />
                        <span asp-validation-for="PaymentDate" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Amount" class="control-label mb-1"></label>
                        <input asp-for="Amount" class="form-control" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Notes" class="control-label mb-1"></label>
                        <textarea asp-for="Notes" class="form-control" ></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                    <div class="row mt-3">
                        <div class="col col-md-6">
                            <a class="btn btn-outline-secondary w-100" asp-action="Index" asp-route-buildingId="@ViewData["BuildingId"]">Back to Payments</a>
                        </div>
                        <div class="col col-md-6">
                            <div class="w-full">
                                <button type="submit" class="btn btn-primary w-100">Add Expense</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}