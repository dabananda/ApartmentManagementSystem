@using ApartmentManagementSystem.ViewModels.Building
@model IEnumerable<BuildingTenantRow>

@{
    ViewData["Title"] = "Building Tenants";
}

<div class="mb-4">
    <h3><strong>Tenants in @ViewData["BuildingName"]</strong></h3>
    <p class="text-muted text-sm">This view shows all tenants currently residing in your building across all flats.</p>
</div>

<table id="buildingTenantsTable" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th>Flat Number</th>
            <th>Tenant Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Flat Owner</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td><span class="badge badge-primary">@row.FlatNumber</span></td>
                <td>@row.TenantName</td>
                <td>
                    @if (!string.IsNullOrEmpty(row.Email))
                    {
                        <a href="mailto:@row.Email">@row.Email</a>
                    }
                    else
                    {

                        <span class="text-muted">Not provided</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(row.PhoneNumber))
                    {
                        <a href="tel:@row.PhoneNumber">@row.PhoneNumber</a>
                    }
                    else
                    {

                        <span class="text-muted">Not provided</span>
                    }
                </td>
                <td>@row.OwnerName</td>
                <td>
                    @if (row.IsActive)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {

                        <span class="badge badge-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="ViewTenants" asp-route-flatId="@row.FlatId" class="btn btn-secondary btn-sm" title="View all tenants in this flat">
                            <i class="fas fa-users"></i> Flat Tenants
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-warning text-center">
        <i class="fas fa-exclamation-triangle"></i>
        <h4>No Tenants Found</h4>
        <p>There are currently no tenants registered in this building.</p>
    </div>
}

@section Scripts {
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
    <script type="text/javascript" src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function() {
            $('#buildingTenantsTable').DataTable({
                responsive: true,
                pageLength: 15,
                lengthMenu: [[15, 25, 50, -1], [15, 25, 50, "All"]],
                order: [[0, "asc"]],
                columnDefs: [
                    { targets: [0], type: "string" },
                    { targets: [5], orderable: true, searchable: true },
                    { targets: [6], orderable: false, searchable: false }
                ]
            });
        });
    </script>
    <style>
        .badge-primary {
            background-color: #007bff;
            color: white;
            padding: .375rem .75rem;
            border-radius: .375rem;
        }

        .badge-success {
            background-color: #28a745;
            color: white;
            padding: .25rem .5rem;
            border-radius: .25rem;
        }

        .badge-secondary {
            background-color: #6c757d;
            color: white;
            padding: .25rem .5rem;
            border-radius: .25rem;
        }

        .btn-group .btn {
            margin-right: 2px;
        }

            .btn-group .btn:last-child {
                margin-right: 0;
            }
    </style>
}
