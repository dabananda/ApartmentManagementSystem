@model ApartmentManagementSystem.Application.Features.Flats.DTOs.FlatCreateViewModel

@{
    ViewData["Title"] = "Create Flat";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header text-center bg-brand-gradient text-white py-3">
                <h4 class="card-title">Create Flat</h4>
                <small class="opacity-75">Create a flat for @ViewData["BuildingName"]</small>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <input type="hidden" asp-for="BuildingId" value="@ViewData["BuildingId"]" />

                    <div class="form-group mb-3">
                        <label asp-for="FlatNumber" class="control-label">Flat Number</label>
                        <input asp-for="FlatNumber" class="form-control" placeholder="Enter flat number (e.g, 1A)" />
                        <span asp-validation-for="FlatNumber" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col">
                            <a class="btn btn-outline-secondary w-100" asp-action="Index" asp-controller="Flat" asp-route-buildingId="@ViewData["BuildingId"]">Back to Flat List</a>
                        </div>
                        <div class="col">
                            <input type="submit" value="Create" class="btn btn-primary w-100" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
