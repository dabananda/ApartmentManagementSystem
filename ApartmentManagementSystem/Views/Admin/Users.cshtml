@using ApartmentManagementSystem.ViewModels.Admin
@model ManageUsersPageViewModel
@{
    ViewData["Title"] = "Manage Users";
    var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.Filter.PageSize));
    var current = Math.Max(1, Model.Filter.Page);
}

<div class="d-flex justify-content-between">
    <h2 class="mb-4">Manage Users</h2>
    <div>
        <a class="btn btn-primary mb-3" asp-controller="Admin" asp-action="CreateUser">
            <i class="fa-solid fa-user-plus me-1"></i>
            Create User
        </a>
    </div>
</div>

<!-- FILTERS -->
<form method="get" asp-controller="Admin" asp-action="Users" class="row justify-content-between mb-3">
    <div class="col-md-3">
        <div class="input-group mb-3">
            <span class="input-group-text" id="basic-addon1">
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input class="form-control" name="Query" placeholder="Search by name, email or phone" value="@Model.Filter.Query">
        </div>
    </div>

    <div class="col-md-3">
        <select class="form-select" name="BuildingId">
            <option value="">All Buildings</option>
            @foreach (var b in Model.Buildings)
            {
                var selected = (Model.Filter.BuildingId.HasValue && Model.Filter.BuildingId.Value.ToString() == b.Value);
                if (selected)
                {
                    <option value="@b.Value" selected="selected">@b.Text</option>
                }
                else
                {
                    <option value="@b.Value">@b.Text</option>
                }
            }
        </select>
    </div>

    <div class="col-md-2">
        <select class="form-select" name="Role">
            @{
                var roles = new[] { "All", "President", "Owner", "Tenant", "Staff" };
            }
            @foreach (var r in roles)
            {
                if (string.Equals(Model.Filter.Role, r, StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@r" selected="selected">@r</option>
                }
                else
                {
                    <option value="@r">@r</option>
                }
            }
        </select>
    </div>

    @* <div class="col-md-2 d-flex align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="LockedOnly" value="true" @(Model.Filter.LockedOnly ? "checked=\"checked\"" : "") />
            <label class="form-check-label">Locked only</label>
        </div>
    </div> *@

    <div class="col-md-2">
        <select class="form-select" name="PageSize">
            @{
                var sizes = new[] { 10, 20, 50, 100 };
            }
            @foreach (var ps in sizes)
            {
                if (Model.Filter.PageSize == ps)
                {
                    <option value="@ps" selected="selected">@ps / page</option>
                }
                else
                {
                    <option value="@ps">@ps / page</option>
                }
            }
        </select>
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary" type="submit">Filter</button>
        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Users">Clear</a>
    </div>
</form>

<!-- FLASH -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Users.Any())
{
    <div class="alert alert-info">No approved users found.</div>
}
else
{
    <!-- SINGLE OUTER FORM (bulk actions). Row buttons override with formaction. -->
    <form id="bulkForm" method="post">
        @Html.AntiForgeryToken()

        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-2">
            <div class="d-flex flex-wrap gap-2">
                <!-- Bulk role changes -->
                <button type="submit"
                        formmethod="post"
                        formaction="@Url.Action("BulkChangeRole", "Admin")"
                        name="role" value="Owner"
                        class="btn btn-success btn-sm">
                    Set selected as Owner
                </button>
                <button type="submit"
                        formmethod="post"
                        formaction="@Url.Action("BulkChangeRole", "Admin")"
                        name="role" value="Tenant"
                        class="btn btn-primary btn-sm">
                    Set selected as Tenant
                </button>
                <button type="submit"
                        formmethod="post"
                        formaction="@Url.Action("BulkChangeRole", "Admin")"
                        name="role" value="Staff"
                        class="btn btn-secondary btn-sm">
                    Set selected as Staff
                </button>

                <!-- Bulk lock/unlock -->
                <button type="submit"
                        formmethod="post"
                        formaction="@Url.Action("BulkBlock", "Admin")"
                        class="btn btn-warning btn-sm">
                    Block selected
                </button>
                <button type="submit"
                        formmethod="post"
                        formaction="@Url.Action("BulkUnblock", "Admin")"
                        class="btn btn-outline-warning btn-sm">
                    Unblock selected
                </button>

                <!-- Bulk delete (SuperAdmin only) -->
                @if (User.IsInRole("SuperAdmin"))
                {
                    <button type="submit"
                            formmethod="post"
                            formaction="@Url.Action("BulkDelete", "Admin")"
                            class="btn btn-outline-danger btn-sm"
                            onclick="return confirm('Delete selected users? This cannot be undone.');">
                        Delete selected
                    </button>
                }
            </div>
            <small class="text-muted">Showing @Model.Users.Count of @Model.Total result(s)</small>
        </div>

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th style="width:28px;"><input type="checkbox" id="chkAll" /></th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Building</th>
                    <th>Roles</th>
                    <th>Email Confirmed</th>
                    <th>Locked</th>
                    <th>Registered</th>
                    <th style="width:350px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    var rolesText = (u.Roles != null && u.Roles.Count > 0) ? string.Join(", ", u.Roles) : "-";
                    <tr>
                        <td><input type="checkbox" name="ids" value="@u.Id" class="chkRow" /></td>
                        <td>@u.Fullname</td>
                        <td>@u.Email</td>
                        <td>@u.PhoneNumber</td>
                        <td>@u.BuildingName</td>
                        <td>@rolesText</td>
                        <td>
                            @if (u.EmailConfirmed)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-warning text-dark">Locked</span>
                            }
                            else
                            {

                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <!-- Role changes -->
                            <button type="submit"
                                    formmethod="post"
                                    formaction="@Url.Action("ChangeRole", "Admin", new { id = u.Id, role = "Owner" })"
                                    class="btn btn-sm btn-success">
                                Make Owner
                            </button>
                            <button type="submit"
                                    formmethod="post"
                                    formaction="@Url.Action("ChangeRole", "Admin", new { id = u.Id, role = "Tenant" })"
                                    class="btn btn-sm btn-primary ms-1"
                                    @((u.IsPresident && !User.IsInRole("SuperAdmin")) ? "disabled" : null)>
                                Make Tenant
                            </button>
                            <button type="submit"
                                    formmethod="post"
                                    formaction="@Url.Action("ChangeRole", "Admin", new { id = u.Id, role = "Staff" })"
                                    class="btn btn-sm btn-secondary ms-1"
                                    @((u.IsPresident && !User.IsInRole("SuperAdmin")) ? "disabled" : null)>
                                Make Staff
                            </button>

                            <!-- Reset to pending -->
                            <button type="submit"
                                    formmethod="post"
                                    formaction="@Url.Action("ResetUser", "Admin", new { id = u.Id })"
                                    class="btn btn-sm btn-outline-secondary ms-1"
                                    @((u.IsPresident && !User.IsInRole("SuperAdmin")) ? "disabled" : null)>
                                Reset
                            </button>

                            <!-- Block / Unblock -->
                            @if (!u.IsLockedOut)
                            {
                                <button type="submit"
                                        formmethod="post"
                                        formaction="@Url.Action("BlockUser", "Admin", new { id = u.Id })"
                                        class="btn btn-sm btn-warning ms-1"
                                        @((u.IsPresident && !User.IsInRole("SuperAdmin")) ? "disabled" : null)>
                                    Block
                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        formmethod="post"
                                        formaction="@Url.Action("UnblockUser", "Admin", new { id = u.Id })"
                                        class="btn btn-sm btn-outline-warning ms-1">
                                    Unblock
                                </button>
                            }

                            <a class="btn btn-sm btn-outline-dark"
                               asp-controller="Admin"
                               asp-action="EditUser"
                               asp-route-id="@u.Id">
                                Update
                            </a>

                            <!-- Delete (SuperAdmin only) -->
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Owner"))
                            {
                                <button type="submit"
                                        formmethod="post"
                                        formaction="@Url.Action("DeleteUser", "Admin", new { id = u.Id })"
                                        class="btn btn-sm btn-outline-danger ms-1"
                                        onclick="return confirm('Delete this user? This cannot be undone.');">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>

    @if (totalPages > 1)
    {
        <nav aria-label="Users pagination">
            <ul class="pagination">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == current ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Admin"
                           asp-action="Users"
                           asp-route-Page="@p"
                           asp-route-PageSize="@Model.Filter.PageSize"
                           asp-route-Query="@Model.Filter.Query"
                           asp-route-BuildingId="@Model.Filter.BuildingId"
                           asp-route-Role="@Model.Filter.Role"
                           asp-route-LockedOnly="@Model.Filter.LockedOnly">
                            @p
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}

@section Scripts {
    <script>
        (function () {
            var chkAll = document.getElementById('chkAll');
            if (!chkAll) return;
            chkAll.addEventListener('change', function (e) {
                var on = e.target.checked;
                var rows = document.querySelectorAll('.chkRow');
                for (var i = 0; i < rows.length; i++) rows[i].checked = on;
            });
        })();
    </script>
}
