@using ApartmentManagementSystem.Features.Administration.ViewModels
@model EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
    var buildings = ViewBag.Buildings as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-header text-center">
                <h3 class="card-title">Edit User</h3>
            </div>
            <div class="card-body">
                <form asp-controller="Admin" asp-action="EditUser" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="col-md-6">
                        <label asp-for="Fullname" class="form-label"></label>
                        <input asp-for="Fullname" class="form-control" />
                        <span asp-validation-for="Fullname" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BuildingId" class="form-label"></label>
                        @if (Model.IsSuperAdminCaller)
                        {
                            <select asp-for="BuildingId" class="form-select" asp-items="buildings">
                                <option value="">-- No building --</option>
                            </select>
                        }
                        else
                        {
                            <input class="form-control" value="@Model.BuildingName" readonly />
                            <input type="hidden" asp-for="BuildingId" />
                            <div class="form-text">Only SuperAdmin can change building.</div>
                        }
                        <span asp-validation-for="BuildingId" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="row">
                            <div class="col">
                                <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary w-100">Back</a>
                            </div>
                            <div class="col">
                                <button type="submit" class="btn btn-primary w-100">Save changes</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function(){
            if (!window.SwalHelpers) return;
            SwalHelpers.bindConfirm("form[asp-action='EditUser'] button[type='submit']",
                { title: 'Save changes to this user?', icon: 'question', confirmText: 'Save' });
        })();
    </script>
}
