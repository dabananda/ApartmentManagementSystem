@model ApartmentManagementSystem.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
    var buildings = ViewBag.Buildings as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<h2 class="mb-3">Edit User</h2>

<form asp-controller="Admin" asp-action="EditUser" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="col-md-6">
        <label asp-for="Fullname" class="form-label"></label>
        <input asp-for="Fullname" class="form-control" />
        <span asp-validation-for="Fullname" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" readonly />
        <div class="form-text">Email (username) is read-only here.</div>
    </div>

    <div class="col-md-6">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="BuildingId" class="form-label"></label>
        @if (Model.IsSuperAdminCaller)
        {
            <select asp-for="BuildingId" class="form-select" asp-items="buildings">
                <option value="">-- No building --</option>
            </select>
        }
        else
        {
            <input class="form-control" value="@Model.BuildingName" readonly />
            <input type="hidden" asp-for="BuildingId" />
            <div class="form-text">Only SuperAdmin can change building.</div>
        }
        <span asp-validation-for="BuildingId" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary ms-1">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}