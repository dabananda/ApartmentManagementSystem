@using ApartmentManagementSystem.Application.Features.Administration.DTOs
@model CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
    var buildings = ViewBag.Buildings as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var roles = ViewBag.Roles as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();

    var isOwner = User.IsInRole("Owner");
    var isPresident = User.IsInRole("President");
    var isSuperAdmin = User.IsInRole("SuperAdmin");

    var canCreateAllRoles = isSuperAdmin || isPresident;
    var filteredRoles = canCreateAllRoles
        ? roles
        : roles.Where(r => string.Equals(r.Value, "Tenant", StringComparison.OrdinalIgnoreCase)).ToList();
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-header text-center">
                <h3 class="card-title">Create New User</h3>
            </div>
            <div class="card-body">
                <form asp-controller="Admin" asp-action="CreateUser" method="post" class="form row g-3">
                    @Html.AntiForgeryToken()

                    <div class="col-md-6">
                        <label asp-for="Fullname" class="form-label"></label>
                        <input asp-for="Fullname" class="form-control" />
                        <span asp-validation-for="Fullname" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BuildingId" class="form-label"></label>
                        <select asp-for="BuildingId" class="form-select" asp-items="buildings"></select>
                        <span asp-validation-for="BuildingId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Role" class="form-label"></label>

                        @if (!canCreateAllRoles)
                        {
                            <input type="hidden" asp-for="Role" value="Tenant" />
                            <input class="form-control" value="Tenant" readonly />
                            <small class="text-muted d-block">As an Owner, you can create <strong>Tenant</strong> users only.</small>
                        }
                        else
                        {
                            <select asp-for="Role" class="form-select" asp-items="filteredRoles"></select>
                        }

                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="row">
                            <div class="col-6">
                                <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary w-100">Back</a>
                            </div>
                            <div class="col-6">
                                <button class="btn btn-primary w-100" type="submit">Create</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function(){
            if (!window.SwalHelpers) return;
            SwalHelpers.bindConfirm("form[asp-action='CreateUser'] button[type='submit']",
                { title: 'Create this user?', icon: 'question', confirmText: 'Create' });
        })();
    </script>
}
