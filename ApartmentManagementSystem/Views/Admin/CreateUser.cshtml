@using ApartmentManagementSystem.ViewModels.Admin
@model CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
    var buildings = ViewBag.Buildings as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var roles = ViewBag.Roles as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();

    var isOwner = User.IsInRole("Owner");
    // If Owner, only allow "Tenant"
    var filteredRoles = isOwner
        ? roles.Where(r => string.Equals(r.Value, "Tenant", StringComparison.OrdinalIgnoreCase)).ToList()
        : roles;
}

<h2 class="mb-3">Create User</h2>

<form asp-controller="Admin" asp-action="CreateUser" method="post" class="row g-3">
    @Html.AntiForgeryToken()

    <div class="col-md-6">
        <label asp-for="Fullname" class="form-label"></label>
        <input asp-for="Fullname" class="form-control" />
        <span asp-validation-for="Fullname" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="BuildingId" class="form-label"></label>
        <select asp-for="BuildingId" class="form-select" asp-items="buildings"></select>
        <span asp-validation-for="BuildingId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Role" class="form-label"></label>

        @if (isOwner)
        {
            <!-- Owner: lock role to Tenant -->
            <input type="hidden" asp-for="Role" value="Tenant" />
            <input class="form-control" value="Tenant" readonly />
            <small class="text-muted d-block">As an Owner, you can create <strong>Tenant</strong> users only.</small>
        }
        else
        {
            <!-- Admin/President/etc: show full roles list -->
            <select asp-for="Role" class="form-select" asp-items="filteredRoles"></select>
            <small class="text-muted d-block">Selecting <strong>President</strong> will also grant <strong>Owner</strong> automatically.</small>
        }

        <span asp-validation-for="Role" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button class="btn btn-primary" type="submit">Create</button>
        <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary ms-1">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function(){
            if (!window.SwalHelpers) return;
            SwalHelpers.bindConfirm("form[asp-action='CreateUser'] button[type='submit']",
                { title: 'Create this user?', icon: 'question', confirmText: 'Create' });
        })();
    </script>
}