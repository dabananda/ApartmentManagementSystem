@using ApartmentManagementSystem.Features.Administration.ViewModels
@model ApprovalsPageViewModel
@{
    ViewData["Title"] = "User Approvals";
    var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.Filter.PageSize));
    var current = Math.Max(1, Model.Filter.Page);
}

<h2 class="mb-3">User Approvals</h2>

<form method="get" asp-controller="Admin" asp-action="Approvals" class="row g-2 mb-3">
    <div class="col-md-3">
        <input class="form-control" name="Query" placeholder="Search name/email/phone" value="@Model.Filter.Query" />
    </div>

    <div class="col-md-3">
        <select class="form-select" name="BuildingId">
            <option value="">All Buildings</option>
            @foreach (var b in Model.Buildings)
            {
                var selected = (Model.Filter.BuildingId.HasValue && Model.Filter.BuildingId.Value.ToString() == b.Value);
                if (selected)
                {
                    <option value="@b.Value" selected="selected">@b.Text</option>
                }
                else
                {
                    <option value="@b.Value">@b.Text</option>
                }
            }
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="OnlyEmailConfirmed" value="true" @(Model.Filter.OnlyEmailConfirmed ? "checked=\"checked\"" : "") />
            <label class="form-check-label">Only email confirmed</label>
        </div>
    </div>

    <div class="col-md-2">
        <select class="form-select" name="PageSize">
            @{
                var sizes = new[] { 10, 20, 50, 100 };
            }
            @foreach (var ps in sizes)
            {
                if (Model.Filter.PageSize == ps)
                {
                    <option value="@ps" selected="selected">@ps / page</option>
                }
                else
                {
                    <option value="@ps">@ps / page</option>
                }
            }
        </select>
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100" type="submit">Filter</button>
    </div>
</form>

@if (!Model.PendingUsers.Any())
{
    <div class="alert alert-info">No users found for the current filters.</div>
}
else
{
    <form id="bulkForm" asp-controller="Admin" asp-action="BulkApprove" method="post">
        @Html.AntiForgeryToken()

        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <button type="submit" name="role" value="Owner" class="btn btn-success btn-sm">
                    Approve selected as Owner
                </button>
                <button type="submit" name="role" value="Tenant" class="btn btn-primary btn-sm ms-1">
                    Approve selected as Tenant
                </button>
                <button type="submit" name="role" value="Staff" class="btn btn-secondary btn-sm ms-1">
                    Approve selected as Staff
                </button>
            </div>
            <small class="text-muted">Showing @Model.PendingUsers.Count of @Model.Total result(s)</small>
        </div>

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th style="width:28px;"><input type="checkbox" id="chkAll" /></th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Building</th>
                    <th>Email Confirmed</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th style="width:260px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.PendingUsers)
                {
                    <tr>
                        <td><input type="checkbox" name="ids" value="@u.Id" class="chkRow" /></td>
                        <td>@u.Fullname</td>
                        <td>@u.Email</td>
                        <td>@u.PhoneNumber</td>
                        <td>@u.BuildingName</td>
                        <td>
                            @if (u.EmailConfirmed)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            @if (u.IsApproved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <button type="submit"
                                    formmethod="post"
                                    formaction="@Url.Action("ApproveUser", "Admin", new { id = u.Id, role = "Owner" })"
                                    class="btn btn-sm btn-success">
                                Owner
                            </button>

                            <button type="submit"
                                    formmethod="post"
                                    formaction="@Url.Action("ApproveUser", "Admin", new { id = u.Id, role = "Tenant" })"
                                    class="btn btn-sm btn-primary ms-1"
                                    @(u.IsPresident ? "disabled" : null)>
                                Tenant
                            </button>

                            <button type="submit"
                                    formmethod="post"
                                    formaction="@Url.Action("ApproveUser", "Admin", new { id = u.Id, role = "Staff" })"
                                    class="btn btn-sm btn-secondary ms-1"
                                    @(u.IsPresident ? "disabled" : null)>
                                Staff
                            </button>

                            <button type="submit"
                                    formmethod="post"
                                    formaction="@Url.Action("ResetUser", "Admin", new { id = u.Id })"
                                    class="btn btn-sm btn-outline-danger ms-1"
                                    @(u.IsPresident ? "disabled" : null)>
                                Reset
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>

    @if (totalPages > 1)
    {
        <nav aria-label="Approvals pagination">
            <ul class="pagination">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == current ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Admin"
                           asp-action="Approvals"
                           asp-route-Page="@p"
                           asp-route-PageSize="@Model.Filter.PageSize"
                           asp-route-Query="@Model.Filter.Query"
                           asp-route-BuildingId="@Model.Filter.BuildingId"
                           asp-route-OnlyEmailConfirmed="@Model.Filter.OnlyEmailConfirmed">
                            @p
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}

@section Scripts {
    <script>
        (function () {
            var chkAll = document.getElementById('chkAll');
            if (chkAll) {
                chkAll.addEventListener('change', function (e) {
                    var on = e.target.checked;
                    var rows = document.querySelectorAll('.chkRow');
                    for (var i = 0; i < rows.length; i++) rows[i].checked = on;
                });
            }

            if (!window.SwalHelpers) return;

            var bulkReq = {
                requireSelection: { formId: 'bulkForm', checkboxSelector: '.chkRow', emptyMessage: 'Select at least one user.' }
            };

            SwalHelpers.bindConfirm("form#bulkForm button[name='role'][value='Owner']",
                { title: 'Approve selected as Owner?', icon: 'question', confirmText: 'Approve', ...bulkReq });

            SwalHelpers.bindConfirm("form#bulkForm button[name='role'][value='Tenant']",
                { title: 'Approve selected as Tenant?', icon: 'question', confirmText: 'Approve', ...bulkReq });

            SwalHelpers.bindConfirm("form#bulkForm button[name='role'][value='Staff']",
                { title: 'Approve selected as Staff?', icon: 'question', confirmText: 'Approve', ...bulkReq });

            SwalHelpers.bindConfirm("button[formaction*='ApproveUser'][formaction*='role=Owner']",
                { title: 'Approve as Owner?', icon: 'question', confirmText: 'Approve' });

            SwalHelpers.bindConfirm("button[formaction*='ApproveUser'][formaction*='role=Tenant']",
                { title: 'Approve as Tenant?', icon: 'question', confirmText: 'Approve' });

            SwalHelpers.bindConfirm("button[formaction*='ApproveUser'][formaction*='role=Staff']",
                { title: 'Approve as Staff?', icon: 'question', confirmText: 'Approve' });

            SwalHelpers.bindConfirm("button[formaction*='ResetUser']",
                { title: 'Reset this user to pending?', icon: 'warning', confirmText: 'Reset' });
        })();
    </script>
}
