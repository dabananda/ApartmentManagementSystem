@model ApartmentManagementSystem.Models.CommonBill
@{
    ViewData["Title"] = "Delete Common Bill";
    var hasPayments = (bool?)ViewData["HasPayments"] ?? false;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <!-- Modern Card -->
            <div class="card shadow border-0">
                <!-- Header -->
                <div class="card-header bg-danger text-white text-center py-3">
                    <div class="d-flex align-items-center justify-content-center">
                        <i class="bi bi-exclamation-triangle fs-4 me-2"></i>
                        <h4 class="mb-0 fw-semibold">Delete Common Bill</h4>
                    </div>
                    <small class="opacity-75">
                        @if (hasPayments)
                        {
                            <span>Cannot delete - has payments</span>
                        }
                        else
                        {
                            <span>Confirm deletion of billing record</span>
                        }
                    </small>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">
                    @if (hasPayments)
                    {
                        <!-- Warning Message -->
                        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-shield-exclamation fs-4 me-3 flex-shrink-0"></i>
                            <div>
                                <h6 class="alert-heading mb-1">Cannot Delete Bill</h6>
                                <p class="mb-0">This bill has recorded payments and cannot be deleted to maintain data integrity.</p>
                            </div>
                        </div>

                        <!-- Bill Details (Read-only) -->
                        <div class="bg-light rounded p-3 mb-4">
                            <h6 class="text-muted mb-3 text-center">Bill Information</h6>

                            <!-- Bill Name -->
                            <div class="mb-2">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-tag text-primary small"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted text-uppercase fw-semibold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Name</small>
                                        <span class="text-dark fw-semibold">@Model.Name</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Amount -->
                            <div class="mb-2">
                                <div class="d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-currency-dollar text-success small"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted text-uppercase fw-semibold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Amount</small>
                                        <span class="text-success fw-bold">@Model.TotalAmount tk</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Date -->
                            <div class="mb-0">
                                <div class="d-flex align-items-center">
                                    <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-calendar3 text-info small"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted text-uppercase fw-semibold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Date</small>
                                        <span class="text-dark fw-semibold">@Model.BillDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Back Button -->
                        <div class="text-center">
                            <a class="btn btn-outline-secondary px-4" asp-action="Index" asp-route-buildingId="@Model.BuildingId">
                                <i class="bi bi-arrow-left me-2"></i>
                                Back to Bills
                            </a>
                        </div>
                    }
                    else
                    {
                        <!-- Bill Details for Confirmation -->
                        <!-- Bill Name -->
                        <div class="mb-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-tag text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <small class="text-muted text-uppercase fw-semibold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Bill Name</small>
                                    <h5 class="mb-0 text-dark fw-bold">@Model.Name</h5>
                                </div>
                            </div>
                        </div>

                        <!-- Total Amount -->
                        <div class="mb-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-currency-dollar text-success"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <small class="text-muted text-uppercase fw-semibold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Amount</small>
                                    <div class="d-flex align-items-baseline">
                                        <h4 class="mb-0 text-success fw-bold">@Model.TotalAmount</h4>
                                        <span class="ms-1 text-success fw-semibold">tk</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Bill Date -->
                        <div class="mb-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-calendar3 text-info"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <small class="text-muted text-uppercase fw-semibold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Bill Date</small>
                                    <h5 class="mb-0 text-dark fw-bold">@Model.BillDate.ToString("MMM dd, yyyy")</h5>
                                </div>
                            </div>
                        </div>

                        <!-- Notes -->
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="mb-4">
                                <div class="d-flex align-items-start">
                                    <div class="bg-secondary bg-opacity-10 rounded-circle p-2 me-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                                        <i class="bi bi-sticky text-secondary"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted text-uppercase fw-semibold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Notes</small>
                                        <p class="mb-0 text-dark">@Model.Notes</p>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Confirmation Form -->
                        <form asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <div class="row g-2">
                                <div class="col-12 col-sm-6">
                                    <a class="btn btn-outline-secondary w-100" asp-action="Index" asp-route-buildingId="@Model.BuildingId">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Cancel
                                    </a>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <button type="submit" class="btn btn-danger w-100">
                                        <i class="bi bi-trash me-1"></i>
                                        Yes, Delete
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1) !important;
        }

    .btn {
        transition: all 0.2s ease;
    }

        .btn:hover {
            transform: translateY(-1px);
        }

    .alert {
        border-radius: 0.75rem;
    }
</style>