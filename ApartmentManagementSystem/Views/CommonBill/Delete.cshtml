@model ApartmentManagementSystem.Models.CommonBill
@{
    ViewData["Title"] = "Delete Common Bill";
    var hasPayments = (bool?)ViewData["HasPayments"] ?? false;
}
<h1>Delete Common Bill</h1>
<hr />

@if (hasPayments)
{
    <div class="alert alert-warning">
        This bill has recorded payments and cannot be deleted.
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-buildingId="@Model.BuildingId">Back to Bills</a>
}
else
{
    <h5>Are you sure you want to delete this bill?</h5>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Total Amount</dt>
        <dd class="col-sm-9">@Model.TotalAmount</dd>
        <dt class="col-sm-3">Bill Date</dt>
        <dd class="col-sm-9">@Model.BillDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Notes</dt>
        <dd class="col-sm-9">@Model.Notes</dd>
    </dl>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-buildingId="@Model.BuildingId">Cancel</a>
        </div>
    </form>
}
