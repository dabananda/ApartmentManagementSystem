@using ApartmentManagementSystem.Features.Owner.ViewModels
@model List<OwnerAllocationRowViewModel>
@{
    ViewData["Title"] = "Owner Payments";
    var buildingId = ViewData["BuildingId"] as Guid? ?? Guid.Empty;
    var billName = ViewData["BillName"] as string ?? string.Empty;
    var billDate = ViewData["BillDate"] as string ?? string.Empty;
    var billTotal = ViewData["BillTotal"] as decimal? ?? 0m;
}

<h2 class="mb-3">Owner Payments — @billName (@billDate)</h2>
<div class="mb-3 text-muted">Bill Total: @billTotal.ToString("C")</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Owner</th>
            <th>Flats</th>
            <th class="text-end">Allocated</th>
            <th class="text-end">Paid</th>
            <th class="text-end">Due</th>
            <th class="text-end">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.OwnerName</td>
                <td>@row.FlatsCsv</td>
                <td class="text-end">@row.TotalAllocated.ToString("C")</td>
                <td class="text-end">@row.TotalPaid.ToString("C")</td>
                <td class="text-end">
                    <strong class="@(row.TotalDue > 0 ? "text-danger" : "text-success")">
                        @row.TotalDue.ToString("C")
                    </strong>
                </td>
                <td class="text-end">
                    @if (row.TotalDue > 0)
                    {
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#payModal"
                                data-owner-id="@row.OwnerId"
                                data-owner-name="@row.OwnerName"
                                data-current-due="@row.TotalDue"
                                data-bill-id="@row.CommonBillId">
                            Add Payment
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-success">Paid</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" asp-route-buildingId="@buildingId" class="btn btn-outline-secondary">Back to Bills</a>

<div class="modal fade" id="payModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddOwnerPayment" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Record Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="CommonBillId" name="CommonBillId" />
                    <input type="hidden" id="OwnerId" name="OwnerId" />

                    <div class="mb-2">
                        <label class="form-label">Owner</label>
                        <input type="text" id="OwnerName" class="form-control" readonly />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Current Due</label>
                        <input type="text" id="CurrentDue" class="form-control" readonly />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Amount</label>
                        <input type="number" step="0.01" min="0.01" class="form-control" name="Amount" id="OwnerPayAmount" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Payment Date</label>
                        <input type="date" class="form-control" name="PaymentDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Reference (optional)</label>
                        <input type="text" maxlength="100" class="form-control" name="Reference" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" type="submit">Save</button>
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('payModal')?.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const ownerId = button.getAttribute('data-owner-id');
            const ownerName = button.getAttribute('data-owner-name');
            const currentDue = button.getAttribute('data-current-due');
            const billId = button.getAttribute('data-bill-id');

            document.getElementById('OwnerId').value = ownerId;
            document.getElementById('OwnerName').value = ownerName;
            document.getElementById('CurrentDue').value = parseFloat(currentDue).toFixed(2);
            document.getElementById('CommonBillId').value = billId;
            document.getElementById('OwnerPayAmount').setAttribute('max', currentDue.toFixed(2));
        });
    </script>
}


