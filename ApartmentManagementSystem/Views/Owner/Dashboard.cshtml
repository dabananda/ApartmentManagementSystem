@using ApartmentManagementSystem.ViewModels.Owner
@model OwnerDashboardVM
@{
    ViewData["Title"] = "Owner Dashboard";
    var rentDue = Model.RentTotalDue;
    var commonDue = Model.CommonTotalDue;
}

<h2 class="mb-3">Owner Dashboard</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Status Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Flats Owned</div>
                <div class="h4 mb-0">@Model.FlatsOwnedCount</div>
                <div class="small text-muted">Occupied: @Model.FlatsOccupiedCount</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Toal Tenant Rent</div>
                <div class="h4 mb-0">@Model.RentTotalBilled.ToString("C")</div>
                <div class="small text-success">Paid: @Model.RentTotalPaid.ToString("C")</div>
                <div class="small @(rentDue > 0 ? "text-danger" : "text-success")">Due: @rentDue.ToString("C")</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Common Bills</div>
                <div class="h4 mb-0">@Model.CommonTotalBilled.ToString("C")</div>
                <div class="small text-success">Paid: @Model.CommonTotalPaid.ToString("C")</div>
                <div class="small @(commonDue > 0 ? "text-danger" : "text-success")">Due: @commonDue.ToString("C")</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Collected Rent</div>
                <div class="h4 mb-0">@Model.RentPaidThisMonth.ToString("C")</div>
                <div class="small text-muted">Since @(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- My Tenants -->
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>My Tenants</strong>
                <a class="btn btn-sm btn-outline-primary" asp-controller="TenantAssignment" asp-action="Assign">Assign Tenant</a>
            </div>
            <div class="card-body">
                @if (Model.Tenants.Count == 0)
                {
                    <div class="text-muted">No active tenants.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Tenant</th>
                                    <th>Email</th>
                                    <th>Flat</th>
                                    <th>From</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.Tenants)
                                {
                                    <tr>
                                        <td>@t.Name</td>
                                        <td>@t.Email</td>
                                        <td>@t.FlatNumber</td>
                                        <td>@t.From.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end">
                                            <a asp-controller="TenantRent" asp-action="View" asp-route-tenantUserId="@t.TenantUserId"
                                               class="btn btn-sm btn-outline-secondary">View Rent</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Rent Payments -->
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header"><strong>Recent Rent Payments</strong></div>
            <div class="card-body">
                @if (Model.RecentRent.Count == 0)
                {
                    <div class="text-muted">No recent rent payments.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Tenant</th>
                                    <th>Flat</th>
                                    <th class="text-end">Amount</th>
                                    <th>Ref</th>
                                    <th class="text-end">Receipt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.RecentRent)
                                {
                                    <tr>
                                        <td>@r.PaymentDate.ToString("yyyy-MM-dd")</td>
                                        <td>@r.TenantName</td>
                                        <td>@r.FlatNumber</td>
                                        <td class="text-end">@r.Amount.ToString("C")</td>
                                        <td>@(string.IsNullOrWhiteSpace(r.Reference) ? "-" : r.Reference)</td>
                                        <td class="text-end">
                                            <a asp-controller="TenantRent" asp-action="Receipt" asp-route-id="@r.PaymentId"
                                               class="btn btn-sm btn-outline-secondary">Print</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Common Bill Payments -->
    <div class="col-12">
        <div class="card shadow-sm mt-4">
            <div class="card-header"><strong>Recent Common Bill Payments</strong></div>
            <div class="card-body">
                @if (Model.RecentCommon.Count == 0)
                {
                    <div class="text-muted">No recent common bill payments.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Bill</th>
                                    <th>Bill Date</th>
                                    <th class="text-end">Amount</th>
                                    <th>Ref</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.RecentCommon)
                                {
                                    <tr>
                                        <td>@c.PaymentDate.ToString("yyyy-MM-dd")</td>
                                        <td>@c.BillTitle</td>
                                        <td>@c.BillDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end">@c.Amount.ToString("C")</td>
                                        <td>@(string.IsNullOrWhiteSpace(c.Reference) ? "-" : c.Reference)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
