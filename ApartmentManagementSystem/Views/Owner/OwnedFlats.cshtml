@using ApartmentManagementSystem.Application.Features.Owner.DTOs
@model List<OwnerOwnedFlatRow>
@{
    ViewData["Title"] = "Owned Flats";
    var canManage = User.IsInRole("Owner") || User.IsInRole("President") || User.IsInRole("SuperAdmin");
}

<h2 class="mb-3">Owned Flats</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No flats found for this owner.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Building</th>
                    <th>Flat</th>
                    <th>Tenant</th>
                    <th>Email</th>
                    <th>Since</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.BuildingName</td>
                        <td>@f.FlatNumber</td>
                        <td>@(string.IsNullOrWhiteSpace(f.CurrentTenantName) ? "No tenant assigned" : f.CurrentTenantName)</td>
                        <td>@(string.IsNullOrWhiteSpace(f.CurrentTenantEmail) ? "-" : f.CurrentTenantEmail)</td>
                        <td>@(f.TenantFrom.HasValue? f.TenantFrom.Value.ToString("yyyy-MM-dd") : "-")</td>
                        <td class="text-end">
                            @if (canManage)
                            {
                                <a asp-controller="TenantAssignment" asp-action="Assign" class="btn btn-sm btn-outline-primary">
                                    Assign / Change Tenant
                                </a>

                                @if (!string.IsNullOrWhiteSpace(f.CurrentTenantUserId))
                                {
                                    <a asp-controller="TenantRent" asp-action="View" asp-route-tenantUserId="@f.CurrentTenantUserId"
                                       class="btn btn-sm btn-outline-secondary ms-1">
                                        View Rent
                                    </a>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
