@using ApartmentManagementSystem.Application.Features.Tenancy.DTOs
@model AssignTenantVM
@{
    ViewData["Title"] = "Assign Tenant to Flat";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header text-center bg-brand-gradient text-white py-3">
                <div class="d-flex align-items-center justify-content-center">
                    <h4 class="mb-0 fw-semibold">Assign Tenant</h4>
                </div>
                <small class="opacity-75"></small>
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Flat</label>
                        <select asp-for="FlatId" class="form-select" asp-items="@(new SelectList(Model.Flats, "Id", "FlatNumber"))"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tenant</label>
                        <select asp-for="TenantUserId" class="form-select"
                                asp-items="@(new SelectList(Model.Tenants, "Id", "Fullname"))"></select>
                    </div>
                    <div class="row">
                        <div class="col">
                            <a asp-action="MyTenants" class="btn btn-secondary w-100">Back to List</a>
                        </div>
                        <div class="col">
                            <button class="btn btn-primary w-100">Assign</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
