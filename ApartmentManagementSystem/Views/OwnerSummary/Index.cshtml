@model IEnumerable<ApartmentManagementSystem.ViewModels.OwnerSummaryRowViewModel>
@{
    ViewData["Title"] = "Owner Summary";
}
<h1 class="mb-3">Owner Summary</h1>
<p class="text-muted">Owners, their flats, and common bill totals for this building.</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Owner</th>
            <th>Flats</th>
            <th class="text-end">Total Common Bills</th>
            <th class="text-end">Total Paid</th>
            <th class="text-end">Total Due</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.OwnerName</td>
                <td>@row.FlatsCsv</td>
                <td class="text-end">@row.TotalCommonBills.ToString("C")</td>
                <td class="text-end">@row.TotalPaid.ToString("C")</td>
                <td class="text-end">$@(row.TotalDue < 0 ? 0 : row.TotalDue)</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a class="btn btn-outline-secondary"
       asp-controller="CommonBill"
       asp-action="Index"
       asp-route-buildingId="@ViewData["BuildingId"]">Back to Bills</a>
</div>
