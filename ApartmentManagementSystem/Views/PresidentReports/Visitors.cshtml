@using System.Text.Json
@model ApartmentManagementSystem.ViewModels.Reports.VisitorReportViewModel
@{
    ViewData["Title"] = "Visitor Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Visitor Report — @Model.BuildingName</h2>
    <a asp-action="VisitorsCsv" asp-route-from="@Model.Filter.From?.ToString("yyyy-MM-dd")"
       asp-route-to="@Model.Filter.To?.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">Export CSV</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="From" class="form-control" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="To" class="form-control" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto align-self-end"><button class="btn btn-primary">Apply</button></div>
</form>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Entries</div><div class="h4">@Model.TotalEntries</div>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted mb-2">By Category (Top)</div>
                <ul class="list-inline mb-0">
                    @foreach (var kv in Model.ByCategory.OrderByDescending(x => x.Value))
                    {
                        <li class="list-inline-item me-3"><strong>@kv.Key</strong>: @kv.Value</li>
                    }
                    @if (!Model.ByCategory.Any())
                    {
                        <li class="text-muted">No entries.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow mb-3">
            <div class="card-header"><strong>Daily Entries</strong></div>
            <div class="card-body"><canvas id="visLine" height="140"></canvas></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow mb-3">
            <div class="card-header"><strong>By Category</strong></div>
            <div class="card-body"><canvas id="visDonut" height="140"></canvas></div>
        </div>
    </div>
</div>

<div class="card shadow">
    <div class="card-header"><strong>Daily Counts</strong></div>
    <div class="card-body table-responsive">
        <table class="table table-sm">
            <thead><tr><th>Date</th><th>Count</th></tr></thead>
            <tbody>
                @foreach (var d in Model.DailyCounts)
                {
                    <tr><td>@d.Day.ToString("yyyy-MM-dd")</td><td>@d.Count</td></tr>
                }
                @if (!Model.DailyCounts.Any())
                {
                    <tr><td colspan="2"><em class="text-muted">No data.</em></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
          // Daily line
          var dailyLabels = @Html.Raw(JsonSerializer.Serialize(
                        Model.DailyCounts.Select(d => d.Day.ToString("yyyy-MM-dd"))));
      var dailyCounts = @Html.Raw(JsonSerializer.Serialize(
                    Model.DailyCounts.Select(d => d.Count)));

      if (dailyLabels.length) {
        var lineCtx = document.getElementById('visLine').getContext('2d');
        new Chart(lineCtx, {
          type: 'line',
          data: {
            labels: dailyLabels,
            datasets: [{
              label: 'Entries',
              data: dailyCounts,
              fill: false,
              borderWidth: 2,
              borderColor: 'rgba(75,192,192,1)',
              pointRadius: 2
            }]
          },
          options: {
            scales: {
              yAxes: [{ ticks: { beginAtZero: true, precision: 0 } }]
            }
          }
        });
      }

          // Category doughnut
          var catPairs = @Html.Raw(JsonSerializer.Serialize(
                    Model.ByCategory.OrderByDescending(kv => kv.Value).ToArray()));
      var catLabels = catPairs.map(p => p.Key || 'Unknown');
      var catValues = catPairs.map(p => p.Value);

          if (catLabels.length) {
            var donutCtx = document.getElementById('visDonut').getContext('2d');
            new Chart(donutCtx, {
              type: 'doughnut',
              data: {
                labels: catLabels,
                datasets: [{
                  data: catValues,
                  backgroundColor: [
                    'rgba(54,162,235,0.6)',
                    'rgba(255,99,132,0.6)',
                    'rgba(255,206,86,0.6)',
                    'rgba(75,192,192,0.6)',
                    'rgba(153,102,255,0.6)',
                    'rgba(201,203,207,0.6)'
                  ],
                  borderColor: [
                    'rgba(54,162,235,1)',
                    'rgba(255,99,132,1)',
                    'rgba(255,206,86,1)',
                    'rgba(75,192,192,1)',
                    'rgba(153,102,255,1)',
                    'rgba(201,203,207,1)'
                  ]
                }]
              },
              options: { legend: { position: 'bottom' } }
            });
          }
        })();
    </script>
}
