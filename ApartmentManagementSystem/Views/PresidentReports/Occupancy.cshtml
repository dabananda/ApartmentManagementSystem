@using System.Text.Json
@model ApartmentManagementSystem.Features.Reports.ViewModels.OccupancyReportViewModel
@{
    ViewData["Title"] = "Occupancy Report";
}
<div class="d-flex justify-content-between">
    <h2 class="h4 mb-3">Occupancy Report — @Model.BuildingName</h2>
    <div>
        <a asp-action="OccupancyCsv" class="btn btn-outline-secondary">Export CSV</a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Flats</div><div class="h4">@Model.TotalFlats</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Occupied</div><div class="h4">@Model.OccupiedFlats</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Vacant</div><div class="h4">@Model.VacantFlats</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Occupancy Rate</div><div class="h4">@Model.OccupancyRate.ToString("0.0")%</div>
            </div>
        </div>
    </div>
</div>
<div class="row mb-3">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Distinct Owners</div><div class="h4">@Model.OwnersCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Tenants</div><div class="h4">@Model.TenantsCount</div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow mb-3">
            <div class="card-header"><strong>Occupancy</strong></div>
            <div class="card-body"><canvas id="occDonut" height="140"></canvas></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow mb-3">
            <div class="card-header"><strong>People Overview</strong></div>
            <div class="card-body"><canvas id="peopleBars" height="140"></canvas></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
          var occCtx = document.getElementById('occDonut').getContext('2d');
          new Chart(occCtx, {
            type: 'doughnut',
            data: {
              labels: ['Occupied', 'Vacant'],
              datasets: [{
                data: [@Model.OccupiedFlats, @Model.VacantFlats],
                backgroundColor: ['rgba(54,162,235,0.6)', 'rgba(201,203,207,0.6)'],
                borderColor: ['rgba(54,162,235,1)', 'rgba(201,203,207,1)']
              }]
            },
            options: { legend: { position: 'bottom' } }
          });

          var pplCtx = document.getElementById('peopleBars').getContext('2d');
          new Chart(pplCtx, {
            type: 'bar',
            data: {
              labels: ['Owners', 'Tenants'],
              datasets: [{
                label: 'Count',
                data: [@Model.OwnersCount, @Model.TenantsCount],
                backgroundColor: ['rgb(167, 227, 153)', 'rgba(255,178,64,0.6)'],
                borderWidth: 1
              }]
            },
            options: { scales: { yAxes: [{ ticks: { beginAtZero: true } }] } }
          });
        })();
    </script>
}
