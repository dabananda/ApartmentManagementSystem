@model ApartmentManagementSystem.Application.Features.Buildings.DTOs.BuildingDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-header text-center">
                <h3 class="card-title">Building Details</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Name)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Address)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Address)
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <div class="row">
                    <div class="col">
                        <a class="w-100 btn btn-outline-secondary" asp-action="Index">Back to List</a>
                    </div>
                    <div class="col">
                        <a class="w-100 btn btn-outline-dark" asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
                    </div>
                    <div class="col">
                        <a class="w-100 btn btn-outline-primary" asp-controller="Flat" asp-action="Index" asp-route-buildingId="@Model.Id" class="btn btn-primary">View Flats</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
