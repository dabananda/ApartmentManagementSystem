@model ApartmentManagementSystem.ViewModels.BuildingIndexPageViewModel
@{
    ViewData["Title"] = "Buildings";
    var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.Filter.PageSize));
    var current = Math.Max(1, Model.Filter.Page);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Buildings</h2>
    <a class="btn btn-primary" asp-controller="Building" asp-action="Create">Create Building</a>
</div>

<form method="get" asp-controller="Building" asp-action="Index" class="row justify-content-between mb-3">
    <div class="col-md-6">
        <div class="input-group mb-3">
            <span class="input-group-text" id="basic-addon1">
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input class="form-control" name="Query" placeholder="Search by name, code or address" value="@Model.Filter.Query">
        </div>
    </div>

    @*<div class="col-md-3">
        <label class="form-label mb-1">Has President</label>
        <select class="form-select" name="HasPresident">
            @{
                var hp = Model.Filter.HasPresident;
            }
            @if (hp == null)
            {
                <option value="" selected="selected">All</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            }
            else if (hp == true)
            {
                <option value="">All</option>
                <option value="true" selected="selected">Yes</option>
                <option value="false">No</option>
            }
            else
            {
                <option value="">All</option>
                <option value="true">Yes</option>
                <option value="false" selected="selected">No</option>
            }
        </select>
    </div>*@

    <div class="col-md-4">
        <div class="d-flex justify-content-end">
            <div class="me-1 flex-grow-1">
                @* <label class="form-label mb-1">Page size</label> *@
                <select class="form-select" name="PageSize">
                    @{
                        var sizes = new[] { 10, 20, 50, 100 };
                    }
                    @foreach (var ps in sizes)
                    {
                        if (Model.Filter.PageSize == ps)
                        {
                            <option value="@ps" selected="selected">@ps per page</option>
                        }
                        else
                        {
                            <option value="@ps">@ps per page</option>
                        }
                    }
                </select>
            </div>

            <div class="">
                <button class="btn btn-outline-primary" type="submit">Filter</button>
                <a class="btn btn-outline-secondary" asp-controller="Building" asp-action="Index">Clear</a>
            </div>
        </div>
    </div>
</form>

@if (!Model.Buildings.Any())
{
    <div class="alert alert-info">No buildings found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Address</th>
                    <th class="text-end">Flats</th>
                    <th class="text-end">Tenants</th>
                    <th class="text-end">Owners</th>
                    <th>President</th>
                    <th style="width:260px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Buildings)
                {
                    <tr>
                        <td>@b.Name</td>
                        <td>@b.Code</td>
                        <td>@b.Address</td>
                        <td class="text-end">@b.FlatsCount</td>
                        <td class="text-end">@b.TenantsCount</td>
                        <td class="text-end">@b.OwnersCount</td>
                        <td>@b.PresidentName</td>
                        <td>
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Building" asp-action="Details" asp-route-id="@b.Id">Details</a>
                            <a class="btn btn-sm btn-outline-primary ms-1" asp-controller="Building" asp-action="Edit" asp-route-id="@b.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger ms-1" asp-controller="Building" asp-action="Delete" asp-route-id="@b.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Buildings pagination">
            <ul class="pagination">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == current ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Building"
                           asp-action="Index"
                           asp-route-Page="@p"
                           asp-route-PageSize="@Model.Filter.PageSize"
                           asp-route-Query="@Model.Filter.Query"
                           asp-route-HasPresident="@(Model.Filter.HasPresident?.ToString().ToLower())">
                            @p
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
