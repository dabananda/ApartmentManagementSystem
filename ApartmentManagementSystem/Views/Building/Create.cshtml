@model ApartmentManagementSystem.Application.Features.Buildings.DTOs.BuildingCreateViewModel

@{
    ViewData["Title"] = "Create Building";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-header text-center">
                <h3 class="card-title">Create New Building</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label">Building Name</label>
                        <input name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input name="Address" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input name="Code" class="form-control" value="@ViewData["SuggestedCode"]" />
                        <small class="text-muted">Leave as-is to auto use the suggested code.</small>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <a asp-action="Index" class="btn btn-secondary w-100">Cancel</a>
                        </div>
                        <div class="col-md-6">
                            <button class="btn btn-primary w-100" type="submit">Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
