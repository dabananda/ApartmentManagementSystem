@using System.Text.Json
@using Microsoft.AspNetCore.Identity
@model ApartmentManagementSystem.ViewModels.President.PresidentDashboardViewModel
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "President Dashboard";
    var currency = "BDT";
    var totalFlats = Model.TotalFlats;
    var occupied = Model.OccupiedFlats;
    var occRate = totalFlats > 0 ? (int)Math.Round((decimal)occupied * 100m / totalFlats) : 0;
    var currentUser = await UserManager.GetUserAsync(User);
    var buildingId = currentUser?.BuildingId;
}

<div class="container-xxl py-4">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 mb-2 d-flex align-items-center">
                <i class="fas fa-chart-line text-primary me-3"></i>
                Dashboard — <span class="text-primary">@Model.BuildingName</span>
            </h1>
            <p class="text-muted mb-0">Overview of billing, payments, occupancy and recent activity</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="CommonBill" asp-action="Create" asp-route-buildingId="@buildingId" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i> New Common Bill
            </a>
            <a asp-controller="Announcement" asp-action="Create" class="btn btn-outline-primary">
                <i class="fas fa-bullhorn me-2"></i> New Announcement
            </a>
        </div>
    </div>

    @if (TempData["DashboardNotice"] is string note && !string.IsNullOrWhiteSpace(note))
    {
        <div class="alert alert-warning d-flex align-items-start mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-3 mt-1"></i>
            <div>@note</div>
        </div>
    }

    <!-- Key Metrics Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card stat-card h-100">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <div class="text-muted small mb-1">Total Common Bills</div>
                            <div class="display-6 fw-bold">@Model.TotalBills</div>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                            <i class="fas fa-file-invoice text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card stat-card h-100">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <div class="text-muted small mb-1">Collected (All Time)</div>
                            <div class="display-6 fw-bold text-success">@currency @Model.TotalCollected.ToString("N2")</div>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-circle p-3">
                            <i class="fas fa-arrow-trend-down text-success fs-4"></i>
                        </div>
                    </div>
                    <div class="small text-success"><i class="fas fa-arrow-up me-1"></i> Inflow</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card stat-card h-100">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <div class="text-muted small mb-1">Payments (All Time)</div>
                            <div class="display-6 fw-bold text-danger">@currency @Model.TotalPayments.ToString("N2")</div>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                            <i class="fas fa-arrow-trend-up text-danger fs-4"></i>
                        </div>
                    </div>
                    <div class="small text-danger"><i class="fas fa-arrow-down me-1"></i> Outflow</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card stat-card h-100">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <div class="text-muted small mb-1">Total Flats</div>
                            <div class="display-6 fw-bold">@Model.TotalFlats</div>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-circle p-3">
                            <i class="fas fa-building text-info fs-4"></i>
                        </div>
                    </div>
                    <div class="small text-muted"><i class="fas fa-home me-1"></i> Units in building</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Metrics Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0 d-flex align-items-center">
                            <i class="fas fa-chart-pie text-primary me-2"></i>
                            Occupancy Status
                        </h5>
                        <span class="badge bg-primary">@occupied / @totalFlats</span>
                    </div>
                    <div class="progress mb-3" style="height:12px;">
                        <div class="progress-bar" role="progressbar" style="width:@occRate%;" aria-valuenow="@occRate" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="h4 mb-0 text-primary">@occRate%</div>
                            <small class="text-muted">Occupied</small>
                        </div>
                        <div class="text-end">
                            <div class="h4 mb-0 text-muted">@(100-occRate)%</div>
                            <small class="text-muted">Available</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3 d-flex align-items-center">
                        <i class="fas fa-walking text-info me-2"></i>
                        Entry Activity
                    </h5>
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="border-end">
                                <div class="h3 mb-1 text-info">@Model.TodayEntries</div>
                                <small class="text-muted">Today's Entries</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="h3 mb-1 text-primary">@Model.Last7dEntries</div>
                            <small class="text-muted">Last 7 Days</small>
                        </div>
                    </div>
                    <div class="mt-3 small text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        Includes visitors, deliveries, contractors, etc.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Charts Row ===== -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Cashflow (last 12 months)</div>
                <div class="card-body">
                    <div class="chart-wrap"><canvas id="cfChart"></canvas></div>
                    <div class="small text-muted mt-2">In = Owners’ payments · Out = Expense payments</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Aging buckets (outstanding)</div>
                <div class="card-body">
                    <div class="chart-wrap--sm"><canvas id="agingChart"></canvas></div>
                    <div class="small text-muted mt-2">Outstanding owner dues by bucket</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Top owners by due</div>
                <div class="card-body">
                    <div class="chart-wrap--sm"><canvas id="topOwnersChart"></canvas></div>
                    <div class="small text-muted mt-2">Who owes the most right now</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Recent Activity (your improved table) ===== -->
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div class="fw-semibold">Recent Activity</div>
                    <div class="text-muted small">Last 25 items</div>
                </div>
                <div class="card-body p-0 pb-2">
                    <div class="table-responsive">
                        <table id="recentTable" class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 200px;">Date/Time</th>
                                    <th style="width: 160px;">Type</th>
                                    <th>Description</th>
                                    <th class="text-end" style="width: 160px;">Amount</th>
                                    <th style="width: 90px;">Dir</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentTransactions != null && Model.RecentTransactions.Any())
                                {
                                    foreach (var t in Model.RecentTransactions)
                                    {
                                        var typeBadge = t.Type switch
                                        {
                                            "OwnerPayment" => "bg-success",
                                            "ExpensePayment" => "bg-danger",
                                            "CommonBillCreated" => "bg-primary",
                                            "EntryLog" => "bg-secondary",
                                            _ => "bg-secondary"
                                        };
                                        var dirBadge = t.Direction == "In" ? "badge bg-success-subtle text-success" :
                                        t.Direction == "Out" ? "badge bg-danger-subtle text-danger" :
                                        "badge bg-secondary-subtle text-secondary";
                                        var iso = t.OccurredAt.ToUniversalTime().ToString("O"); // ISO UTC
                                                                                                <tr>
                                                                                                    <td data-order="@iso">
                                                                                                        <time class="js-when" datetime="@iso" data-iso="@iso"></time>
                                                                                                    </td>
                                                                                                    <td><span class="badge @typeBadge">@t.Type</span></td>
                                                                                                    <td>@t.Description</td>
                                                                                                    <td class="text-end">
                                                @if (t.Amount.HasValue)
                                                {
                                                    @($"{t.Currency ?? currency} {t.Amount.Value:N2}")
                                                }
                                            </td>
                                            <td><span class="@dirBadge">@t.Direction</span></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            No recent activity to show.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section HeadStyles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.css" />

    <style>
        .chart-wrap {
            position: relative;
            height: 260px;
        }

        .chart-wrap--sm {
            position: relative;
            height: 220px;
        }
        @@media (max-width: 576px) {
            .chart-wrap

        {
            height: 220px;
        }

        .chart-wrap--sm {
            height: 200px;
        }

        }

        .progress {
            background: #eef2f6;
        }

        .progress-bar {
            transition: width .4s ease;
        }

        .card .display-6 {
            font-size: clamp(1.5rem, 3vw, 2.5rem);
        }

        .table > :not(caption) > * > * {
            vertical-align: middle;
        }
    </style>

}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    <script>
        // ===== Time rendering (Asia/Dhaka) =====
        function fmtDhaka(iso) {
            try {
                const dt = new Date(iso); // UTC
                const opts = {
                    timeZone: 'Asia/Dhaka',
                    year: 'numeric', month: '2-digit', day: '2-digit',
                    hour: '2-digit', minute: '2-digit', hour12: false
                };
                const parts = new Intl.DateTimeFormat('en-GB', opts).formatToParts(dt);
                const dict = Object.fromEntries(parts.map(p => [p.type, p.value]));
                return `${dict.year}-${dict.month}-${dict.day} ${dict.hour}:${dict.minute}`;
            } catch { return iso; }
        }

        // ===== DataTables =====
        $(function () {
            document.querySelectorAll('time.js-when').forEach(t => {
                const iso = t.getAttribute('data-iso');
                t.textContent = fmtDhaka(iso);
            });

            $('#recentTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                stateSave: true
            });
        });

        // ===== Charts =====
        (function(){
            const cf = @Html.Raw(JsonSerializer.Serialize(Model.Cashflow));
            const aging = @Html.Raw(JsonSerializer.Serialize(Model.Aging));
            const top = @Html.Raw(JsonSerializer.Serialize(Model.TopOwners));

            // Cashflow (line)
            const ctx1 = document.getElementById('cfChart');
            if (ctx1 && cf && cf.Labels && cf.Labels.length) {
                new Chart(ctx1, {
                    type: 'line',
                    data: {
                        labels: cf.Labels,
                        datasets: [
                            { label: 'In', data: cf.In, tension: 0.25 },
                            { label: 'Out', data: cf.Out, tension: 0.25 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }

            // Aging (doughnut)
            const ctx2 = document.getElementById('agingChart');
            if (ctx2) {
                const vals = [aging.D0_30, aging.D31_60, aging.D61_90, aging.D90Plus];
                new Chart(ctx2, {
                    type: 'doughnut',
                    data: {
                        labels: ['0–30', '31–60', '61–90', '90+'],
                        datasets: [{ data: vals }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }

            // Top owners (horizontal bar)
            const ctx3 = document.getElementById('topOwnersChart');
            if (ctx3 && top && top.Labels && top.Labels.length) {
                new Chart(ctx3, {
                    type: 'bar',
                    data: {
                        labels: top.Labels,
                        datasets: [{ label: 'Outstanding', data: top.Values }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { x: { beginAtZero: true } }
                    }
                });
            }
        })();
    </script>
}
