@using System.Text.Json
@using Microsoft.AspNetCore.Identity
@model ApartmentManagementSystem.Features.President.ViewModels.PresidentDashboardViewModel
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "President Dashboard";
    var currency = "BDT"; // Updated to match controller currency string if desired, or keep "tk"
    var totalFlats = Model.TotalFlats;
    var occupied = Model.OccupiedFlats;
    var occRate = totalFlats > 0 ? (int)Math.Round((decimal)occupied * 100m / totalFlats) : 0;
    var currentUser = await UserManager.GetUserAsync(User);
    var buildingId = currentUser?.BuildingId;
}

<div class="container-xxl">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">Dashboard — <span class="text-primary">@Model.BuildingName</span></h1>
            <div class="text-muted small">Overview of billing, payments, occupancy and recent activity</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="CommonBill" asp-action="Create" asp-route-buildingId="@buildingId" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> New Common Bill
            </a>
            <a asp-controller="Announcement" asp-action="Create" class="btn btn-outline-secondary">
                <i class="bi bi-megaphone me-1"></i> New Announcement
            </a>
        </div>
    </div>

    @if (TempData["DashboardNotice"] is string note && !string.IsNullOrWhiteSpace(note))
    {
        <div class="alert alert-warning d-flex align-items-start" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>@note</div>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Common Bills</div>
                    <div class="display-6 fw-semibold">@Model.TotalBills</div>
                    <div class="text-primary opacity-75"></div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Collected (All Time)</div>
                    <div class="display-6 fw-semibold">@Model.TotalCollected.ToString("N2") @currency</div>
                    <div class="text-success mt-1"><i class="bi bi-arrow-down-left-circle me-1"></i> Inflow</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Payments (All Time)</div>
                    <div class="display-6 fw-semibold">@Model.TotalPayments.ToString("N2") @currency</div>
                    <div class="text-danger mt-1"><i class="bi bi-arrow-up-right-circle me-1"></i> Outflow</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Collected (This Month)</div>
                    <div class="display-6 fw-semibold">@Model.CollectedThisMonth.ToString("N2") @currency</div>
                    <div class="text-success mt-1"><i class="bi bi-calendar-check me-1"></i> Current Month</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Payments (This Month)</div>
                    <div class="display-6 fw-semibold">@Model.PaymentsThisMonth.ToString("N2") @currency</div>
                    <div class="text-danger mt-1"><i class="bi bi-calendar-x me-1"></i> Current Month</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Flats</div>
                    <div class="display-6 fw-semibold">@Model.TotalFlats</div>
                    <div class="text-muted mt-1"><i class="bi bi-building me-1"></i> Units in building</div>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <div class="text-muted small">Occupancy</div>
                        <div class="small text-muted">@occupied / @totalFlats</div>
                    </div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width:@occRate%;"
                             aria-valuenow="@occRate" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="mt-2 fw-semibold">@occRate% occupied</div>
                    <div class="text-muted small">Active tenant assignments across flats</div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6 border-end">
                            <div class="text-muted small">Entries Today</div>
                            <div class="display-6 fw-semibold">@Model.TodayEntries</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">Entries (Last 7 Days)</div>
                            <div class="display-6 fw-semibold">@Model.Last7dEntries</div>
                        </div>
                    </div>
                    <div class="text-muted small mt-2"><i class="bi bi-person-walking me-1"></i> Visitor logs include visitors, delivery, contractors, etc.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Cashflow (last 12 months)</div>
                <div class="card-body">
                    <div class="chart-wrap"><canvas id="cfChart"></canvas></div>
                    <div class="small text-muted mt-2">In = Owners' payments · Out = Expense payments</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Aging buckets (outstanding)</div>
                <div class="card-body">
                    <div class="chart-wrap--sm"><canvas id="agingChart"></canvas></div>
                    <div class="small text-muted mt-2">Outstanding owner dues by bucket</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Top owners by due</div>
                <div class="card-body">
                    <div class="chart-wrap--sm"><canvas id="topOwnersChart"></canvas></div>
                    <div class="small text-muted mt-2">Who owes the most right now</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div class="fw-semibold">Recent Activity</div>
                    <div class="text-muted small">Last 25 items</div>
                </div>
                <div class="card-body p-0 pb-2">
                    @if (Model.RecentTransactions?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table id="recentTable" class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 200px;">Date/Time</th>
                                        <th style="width: 160px;">Type</th>
                                        <th>Description</th>
                                        <th class="text-end" style="width: 160px;">Amount</th>
                                        <th style="width: 90px;">Dir</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.RecentTransactions)
                                    {
                                        var typeBadge = t.Type switch
                                        {
                                            "OwnerPayment" => "bg-success",
                                            "ExpensePayment" => "bg-danger",
                                            "CommonBillCreated" => "bg-primary",
                                            "EntryLog" => "bg-secondary",
                                            _ => "bg-secondary"
                                        };
                                        var dirBadge = t.Direction == "In" ? "badge bg-success-subtle text-success" :
                                        t.Direction == "Out" ? "badge bg-danger-subtle text-danger" :
                                        "badge bg-secondary-subtle text-secondary";
                                        var iso = t.OccurredAt.ToUniversalTime().ToString("O");

                                        <tr>
                                            <td data-order="@iso">
                                                <time class="js-when" datetime="@iso" data-iso="@iso"></time>
                                            </td>
                                            <td><span class="badge @typeBadge">@(t.Type ?? "N/A")</span></td>
                                            <td>@(t.Description ?? "N/A")</td>
                                            <td class="text-end">
                                                @if (t.Amount.HasValue)
                                                {
                                                    <text>@(t.Currency ?? currency) @t.Amount.Value.ToString("N2")</text>
                                                }
                                                else
                                                {
                                                    <text>-</text>
                                                }
                                            </td>
                                            <td><span class="@dirBadge">@(t.Direction ?? "N/A")</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            No recent activity to show.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section HeadStyles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.css" />

    <style>
        .chart-wrap {
            position: relative;
            height: 260px;
        }

        .chart-wrap--sm {
            position: relative;
            height: 220px;
        }

        @@media (max-width: 576px) {
            .chart-wrap {
                height: 220px;
            }

            .chart-wrap--sm {
                height: 200px;
            }
        }

        .progress {
            background: #eef2f6;
        }

        .progress-bar {
            transition: width .4s ease;
        }

        .card .display-6 {
            font-size: clamp(1.5rem, 3vw, 2.5rem);
        }

        .table > :not(caption) > * > * {
            vertical-align: middle;
        }
    </style>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    <script>
        function fmtDhaka(iso) {
            try {
                const dt = new Date(iso);
                const opts = {
                    timeZone: 'Asia/Dhaka',
                    year: 'numeric', month: '2-digit', day: '2-digit',
                    hour: '2-digit', minute: '2-digit', hour12: false
                };
                const parts = new Intl.DateTimeFormat('en-GB', opts).formatToParts(dt);
                const dict = Object.fromEntries(parts.map(p => [p.type, p.value]));
                return `${dict.year}-${dict.month}-${dict.day} ${dict.hour}:${dict.minute}`;
            } catch { return iso; }
        }

        $(function () {
            document.querySelectorAll('time.js-when').forEach(t => {
                const iso = t.getAttribute('data-iso');
                if (iso) {
                    t.textContent = fmtDhaka(iso);
                }
            });

            const tableElement = document.getElementById('recentTable');
            if (tableElement) {
                $('#recentTable').DataTable({
                    order: [[0, 'desc']],
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 100],
                    stateSave: true
                });
            }
        });

        (function(){
            const cf = @Html.Raw(JsonSerializer.Serialize(Model.Cashflow));
            const aging = @Html.Raw(JsonSerializer.Serialize(Model.Aging));
            const top = @Html.Raw(JsonSerializer.Serialize(Model.TopOwners));

            const ctx1 = document.getElementById('cfChart');
            if (ctx1 && cf && cf.Labels && cf.Labels.length) {
                new Chart(ctx1, {
                    type: 'line',
                    data: {
                        labels: cf.Labels,
                        datasets: [
                            { label: 'In', data: cf.In, tension: 0.25 },
                            { label: 'Out', data: cf.Out, tension: 0.25 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }

            const ctx2 = document.getElementById('agingChart');
            if (ctx2) {
                const vals = [aging.D0_30, aging.D31_60, aging.D61_90, aging.D90Plus];
                new Chart(ctx2, {
                    type: 'doughnut',
                    data: {
                        labels: ['0–30', '31–60', '61–90', '90+'],
                        datasets: [{ data: vals }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }

            const ctx3 = document.getElementById('topOwnersChart');
            if (ctx3 && top && top.Labels && top.Labels.length) {
                new Chart(ctx3, {
                    type: 'bar',
                    data: {
                        labels: top.Labels,
                        datasets: [{ label: 'Outstanding', data: top.Values }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { x: { beginAtZero: true } }
                    }
                });
            }
        })();
    </script>
}
