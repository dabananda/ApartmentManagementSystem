@model IEnumerable<ApartmentManagementSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "Pending Users";
}
<h2>Pending Users</h2>
@if (!Model.Any())
{
    <div class="alert alert-info">No pending users.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Fullname</td>
                    <td>@u.Email</td>
                    <td>@u.PhoneNumber</td>
                    @* <td>
                        <form method="post" asp-action="ApproveAndAssign" asp-route-userId="@u.Id" class="d-inline">
                            <input type="hidden" name="role" value="Owner" />
                            <button class="btn btn-sm btn-success">Approve as Owner</button>
                        </form>
                        <form method="post" asp-action="ApproveAndAssign" asp-route-userId="@u.Id" class="d-inline ms-1">
                            <input type="hidden" name="role" value="Tenant" />
                            <button class="btn btn-sm btn-primary">Approve as Tenant</button>
                        </form>
                    </td> *@
                    <td>
                        <form method="post" asp-action="ApproveAndAssign" asp-route-userId="@u.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="role" value="Tenant" />
                            <button class="btn btn-sm btn-primary">Approve as Tenant</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
