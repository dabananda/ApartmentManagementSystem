@model ErrorViewModel
@{
    ViewData["Title"] = "Server Error";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <h1 class="display-1 fw-bold text-danger mb-3">500</h1>
                    <h2 class="h3 mb-4">Internal Server Error.</h2>
                    <p class="text-muted mb-4">
                        An unexpected error occurred while processing your request. Our support team has been notified.
                    </p>
                    
                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-secondary text-start mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Support ID:</strong> <code>@Model.RequestId</code>
                            <br />
                            <small class="text-muted">Please provide this ID when contacting support.</small>
                        </div>
                    }

                    <a href="~/" class="btn btn-primary btn-lg rounded-pill px-4">
                        <i class="fas fa-home me-2"></i>Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
