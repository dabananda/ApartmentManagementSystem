@using System.Text.Encodings.Web
@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    var info = TempData["Info"] as string;
    var warn = TempData["Warning"] as string;
}
@if (success != null || error != null || info != null || warn != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (!window.Swal) return;
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true
            });

            const msgs = [
                { icon: 'success', title: '@JavaScriptEncoder.Default.Encode(success ?? "")' },
                { icon: 'error',   title: '@JavaScriptEncoder.Default.Encode(error ?? "")' },
                { icon: 'info',    title: '@JavaScriptEncoder.Default.Encode(info ?? "")' },
                { icon: 'warning', title: '@JavaScriptEncoder.Default.Encode(warn ?? "")' }
            ];
            msgs.forEach(m => { if (m.title) Toast.fire(m); });
        });
    </script>
}
