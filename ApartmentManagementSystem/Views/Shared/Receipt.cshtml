@using ApartmentManagementSystem.Features.Tenancy.ViewModels
@model ReceiptViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Payment Receipt";
}

<style>
    @@media print {
        .no-print

    {
        display: none !important;
    }

    body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    }

    .receipt-card {
        max-width: 720px;
        margin: 0 auto;
        border: 1px solid #dee2e6;
        border-radius: .5rem;
        padding: 1.25rem;
    }

    .receipt-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .receipt-title {
        margin: 0;
    }

    .receipt-meta {
        font-size: .9rem;
        color: #6c757d;
    }

    .table-receipt td, .table-receipt th {
        padding: .5rem .75rem;
    }

    .table-receipt th {
        width: 30%;
        background: #f8f9fa;
    }
</style>

<div class="receipt-card">
    <div class="receipt-header">
        <h3 class="receipt-title">Payment Receipt</h3>
        <div class="text-end receipt-meta">
            <div><strong>Receipt #:</strong> @Model.ReceiptNo</div>
            <div><strong>Date:</strong> @Model.PaidOn.ToString("yyyy-MM-dd")</div>
        </div>
    </div>

    <div class="mb-3">
        <div><strong>Payer:</strong> @Model.OwnerName</div>
        @if (!string.IsNullOrWhiteSpace(Model.OwnerEmail))
        {
            <div><strong>Email:</strong> @Model.OwnerEmail</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.BuildingName) || !string.IsNullOrWhiteSpace(Model.FlatNumber))
        {
            <div>
                <strong>Flat:</strong> @Model.FlatNumber
                <span class="text-muted">(@Model.BuildingName)</span>
            </div>
        }
    </div>

    <table class="table table-bordered table-receipt">
        <tbody>
            <tr>
                <th>Bill Title</th>
                <td>@Model.BillTitle</td>
            </tr>
            <tr>
                <th>Bill Date</th>
                <td>@Model.BillDate.ToString("yyyy-MM-dd")</td>
            </tr>
            <tr>
                <th>Paid Amount</th>
                <td><strong>@Model.Amount.ToString("C")</strong></td>
            </tr>
            <tr>
                <th>Reference</th>
                <td>@(string.IsNullOrWhiteSpace(Model.Reference) ? "-" : Model.Reference)</td>
            </tr>
            <tr>
                <th>Paid On</th>
                <td>@Model.PaidOn.ToString("yyyy-MM-dd")</td>
            </tr>
        </tbody>
    </table>

    <div class="mt-3 d-flex gap-2 no-print">
        <button class="btn btn-primary" onclick="window.print()">Print</button>
        <a class="btn btn-outline-secondary" href="javascript:history.back()">Back</a>
    </div>
</div>
