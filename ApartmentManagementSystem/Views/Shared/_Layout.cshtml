@* Views/Shared/_Layout.cshtml *@
@using System.Security.Claims

@{
    var buildingIdClaim = User.FindFirst("building_id")?.Value;
    Guid? buildingId = Guid.TryParse(buildingIdClaim, out var gid) ? gid : (Guid?)null;

    bool isOwner = User.IsInRole("Owner");
    bool isPresident = User.IsInRole("President");
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AMS</title>

    <!-- Core styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- App styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    @RenderSection("HeadStyles", required: false)
    @RenderSection("HeadContent", required: false)
</head>
<body>
    <!-- Top navbar -->
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3" asp-controller="Home" asp-action="Index">
            Apartment Management
        </a>

        <button class="navbar-toggler position-absolute d-md-none collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#sidebarMenu"
                aria-controls="sidebarMenu"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="ms-auto navbar-nav">
            <div class="nav-item text-nowrap">
                @* <partial name="_LoginPartial" /> *@
            </div>
        </div>
    </header>

    <!-- Sidebar + main content -->
    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
                <div class="position-sticky pt-3 sidebar-sticky">
                    <ul class="nav flex-column">
                        @* ---------- SuperAdmin ---------- *@
                        @if (isSuperAdmin)
                        {
                            <li class="nav-item">
                                <span class="nav-link disabled"><strong>SuperAdmin's Dashboard</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="SuperAdmin" asp-action="Dashboard">
                                    <i class="bi bi-speedometer me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Approvals">
                                    <i class="bi bi-people me-1"></i> Pending Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                    <i class="bi bi-people me-1"></i> Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="CreateUser">
                                    <i class="bi bi-person-plus me-1"></i> Create User
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="AssignPresident">
                                    <i class="bi bi-p-circle me-1"></i> Assign President
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Building" asp-action="Index">
                                    <i class="bi bi-buildings me-1"></i> Buildings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Flat" asp-action="AllFlats">
                                    <i class="bi bi-house-door me-1"></i> Flats
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="EntryLog" asp-action="Index">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Entry Logs
                                </a>
                            </li>
                        }

                        @* ---------- President ---------- *@
                        @if (isPresident && buildingId != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link disabled"><strong>President's Dashboard</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="President" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Approvals">
                                    <i class="bi bi-people me-1"></i> Pending Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                    <i class="bi bi-people me-1"></i> Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="CommonBill" asp-action="Index" asp-route-buildingId="@buildingId">
                                    <i class="bi bi-receipt me-1"></i> Common Bills
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="OwnerBilling" asp-action="Index" asp-route-buildingId="@buildingId">
                                    <i class="bi bi-coin me-1"></i> Owner Bills
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ExpensePayment" asp-action="Index" asp-route-buildingId="@buildingId">
                                    <i class="bi bi-cash-coin me-1"></i> Bill Pay
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Flat" asp-action="Index" asp-route-buildingId="@buildingId">
                                    <i class="bi bi-house-door me-1"></i> Flats
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Tenant" asp-action="BuildingTenants">
                                    <i class="bi bi-people me-1"></i> Tenants
                                </a>
                            </li>

                            <li class="nav-item"><hr /></li>

                            @* ---------- Reports ---------- *@
                            <li class="nav-item">
                                <span class="nav-link disabled"><strong>Reports</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PresidentReports" asp-action="Financial">
                                    <i class="bi bi-cash-coin me-1"></i> Financial
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PresidentReports" asp-action="Occupancy">
                                    <i class="bi bi-house-door me-1"></i> Occupancy
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PresidentReports" asp-action="Visitors">
                                    <i class="bi bi-people me-1"></i> Visitors
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PresidentReports" asp-action="Maintenance">
                                    <i class="bi bi-tools me-1"></i> Maintenance
                                </a>
                            </li>
                            <li class="nav-item"><hr /></li>
                        }
                        else if (isPresident)
                        {
                            <li class="nav-item text-danger px-3">
                                Your account isn’t linked to a building yet. Ask Super Admin to assign one.
                            </li>
                        }

                        @* ---------- Owner ---------- *@
                        @if (isOwner)
                        {
                            <li class="nav-item">
                                <span class="nav-link disabled"><strong>Owner's Dashboard</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Owner" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="CreateUser">
                                    <i class="bi bi-person-plus me-1"></i> Create Tenant
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantAssignment" asp-action="MyTenants">
                                    <i class="bi bi-people me-1"></i> My Tenants
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Owner" asp-action="OwnedFlats">
                                    <i class="bi bi-house-door me-1"></i> My Flats
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantAssignment" asp-action="Assign">
                                    <i class="bi bi-person-plus-fill me-1"></i> Assign Tenant to Flat
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="FlatBillingProfile" asp-action="Index">
                                    <i class="bi bi-file-text me-1"></i> Flat Billing Profiles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantRent" asp-action="List">
                                    <i class="bi bi-cash-stack me-1"></i> Tenant Rent
                                </a>
                            </li>
                            <li class="nav-item"><hr /></li>
                        }

                        @* ---------- Tenant ---------- *@
                        @if (User.IsInRole("Tenant"))
                        {
                            <li class="nav-item">
                                <span class="nav-link disabled"><strong>Tenant's Dashboard</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> My Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Bills">
                                    <i class="fa-solid fa-file-invoice-dollar me-1"></i> My Bills
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Payments">
                                    <i class="fa-solid fa-file-invoice-dollar me-1"></i> My Payments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Notices">
                                    <i class="bi bi-megaphone me-1"></i> Notices
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Tickets">
                                    <i class="bi bi-tools me-1"></i> Maintenance Tickets
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Visitors">
                                    <i class="bi bi-people me-1"></i> Visitors
                                </a>
                            </li>
                            <li class="nav-item"><hr /></li>
                        }

                        @* ---------- Staff ---------- *@
                        @if (User.IsInRole("Staff") || isPresident || isOwner)
                        {
                            <li class="nav-item">
                                <span class="nav-link disabled"><strong>Staff's Dashboard</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="EntryLog" asp-action="Index">
                                    <i class="bi bi-person-walking"></i>
                                    Entry Logs
                                </a>
                            </li>
                            <li class="nav-item"><hr /></li>
                        }

                        @* ---------- Login/Logout ---------- *@
                        @* <li class="nav-item">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <form id="logoutForm" asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            }
                        </li> *@
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 my-md-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Core scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>

    @* Optional vendor scripts per-page only *@
    @RenderSection("VendorScripts", required: false)
    @RenderSection("Scripts", required: false)
</body>
</html>