@using System.Security.Claims

@{
    var buildingIdClaim = User.FindFirst("building_id")?.Value;
    Guid? buildingId = Guid.TryParse(buildingIdClaim, out var gid) ? gid : (Guid?)null;

    bool isOwner = User.IsInRole("Owner");
    bool isPresident = User.IsInRole("President");
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AMS</title>

    <!-- Core styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- App styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    @RenderSection("HeadStyles", required: false)
    @RenderSection("HeadContent", required: false)
</head>
<body class="bg-light">
    <!-- Modern Top Navbar -->
    <header class="navbar navbar-expand-lg navbar-dark sticky-top shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="container-fluid px-3">
            <!-- Brand -->
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <div class="brand-icon me-2 d-flex align-items-center justify-content-center"
                     style="width: 32px; height: 32px; background: rgba(255,255,255,0.2); border-radius: 8px;">
                    <i class="bi bi-building text-white"></i>
                </div>
                <span class="d-none d-md-inline">Apartment Management</span>
                <span class="d-md-none">AMS</span>
            </a>

            <!-- Mobile toggle button -->
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#sidebarOffcanvas" aria-controls="sidebarOffcanvas">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Right side nav items -->
            <div class="navbar-nav ms-auto d-flex flex-row align-items-center">
                <!-- Notifications (optional) -->
                <div class="nav-item me-3 d-none d-lg-block">
                    <button class="btn btn-link text-white p-2 position-relative">
                        <i class="bi bi-bell fs-5"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6em;">
                            3
                        </span>
                    </button>
                </div>

                <!-- Home link -->
                <div class="nav-item me-2">
                    <a class="nav-link text-white px-3 py-2 rounded-3 bg-opacity-10 bg-white d-flex align-items-center"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house me-1 d-none d-md-inline"></i>
                        <span class="d-none d-md-inline">Home</span>
                        <i class="bi bi-house d-md-none"></i>
                    </a>
                </div>

                <!-- Login/Logout -->
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Desktop Sidebar -->
            <nav class="col-lg-3 col-xl-2 d-none d-lg-block sidebar-modern">
                <div class="sidebar-content h-100">
                    @* @Html.Partial("_SidebarContent") *@
                    <partial name="_SidebarContent" />
                </div>
            </nav>

            <!-- Mobile Offcanvas Sidebar -->
            <div class="offcanvas offcanvas-start sidebar-offcanvas" tabindex="-1" id="sidebarOffcanvas">
                <div class="offcanvas-header border-bottom">
                    <h6 class="offcanvas-title fw-semibold text-dark">Navigation</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                </div>
                <div class="offcanvas-body p-0">
                    @* @Html.Partial("_SidebarContent") *@
                    <partial name="_SidebarContent" />
                </div>
            </div>

            <!-- Main Content -->
            <main class="col-lg-9 col-xl-10 main-content">
                <div class="content-wrapper p-3 p-lg-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <!-- Core scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>

    @* Optional vendor scripts per-page only *@
    @RenderSection("VendorScripts", required: false)
    @RenderSection("Scripts", required: false)

    <style>
        /* Modern Sidebar Styles */
        .sidebar-modern {
            background: #ffffff;
            border-right: 1px solid #e9ecef;
            min-height: calc(100vh - 72px);
            box-shadow: 2px 0 10px rgba(0,0,0,0.05);
        }

        .sidebar-content {
            padding: 1.5rem 0;
            position: sticky;
            top: 72px;
            max-height: calc(100vh - 72px);
            overflow-y: auto;
        }

        .sidebar-offcanvas {
            width: 300px;
            background: #ffffff;
        }

        .nav-section-title {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            color: #6c757d;
            padding: 0.5rem 1.5rem 0.25rem;
            margin: 1rem 0 0.5rem 0;
            letter-spacing: 0.05em;
        }

            .nav-section-title:first-child {
                margin-top: 0;
            }

        .sidebar-nav-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.5rem;
            color: #495057;
            text-decoration: none;
            font-weight: 500;
            border-radius: 0;
            margin: 0;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }

            .sidebar-nav-link:hover {
                background: linear-gradient(90deg, rgba(102, 126, 234, 0.1) 0%, rgba(102, 126, 234, 0.05) 100%);
                color: #667eea;
                text-decoration: none;
                border-left-color: #667eea;
            }

            .sidebar-nav-link.active {
                background: linear-gradient(90deg, rgba(102, 126, 234, 0.15) 0%, rgba(102, 126, 234, 0.08) 100%);
                color: #667eea;
                font-weight: 600;
                border-left-color: #667eea;
            }

            .sidebar-nav-link i {
                width: 20px;
                height: 20px;
                margin-right: 0.75rem;
                font-size: 1rem;
                opacity: 0.7;
                transition: opacity 0.2s ease;
            }

            .sidebar-nav-link:hover i,
            .sidebar-nav-link.active i {
                opacity: 1;
            }

        .nav-divider {
            height: 1px;
            background: #e9ecef;
            margin: 1rem 1.5rem;
        }

        .warning-message {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            margin: 1rem 1.5rem;
            font-size: 0.875rem;
            color: #856404;
        }

        .main-content {
            min-height: calc(100vh - 72px);
            background: #f8f9fa;
        }

        .content-wrapper {
            min-height: calc(100vh - 72px);
        }

        /* Scrollbar styling */
        .sidebar-content::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar-content::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar-content::-webkit-scrollbar-thumb {
            background-color: rgba(0, 0, 0, 0.2);
            border-radius: 3px;
        }

            .sidebar-content::-webkit-scrollbar-thumb:hover {
                background-color: rgba(0, 0, 0, 0.3);
            }

        /* Mobile responsiveness */
        @@media (max-width: 991.98px) {
            .sidebar-nav-link

        {
            padding: 0.875rem 1rem;
        }

        .nav-section-title {
            padding: 0.5rem 1rem 0.25rem;
        }

        .nav-divider {
            margin: 1rem;
        }

        .warning-message {
            margin: 1rem;
        }

        }
    </style>
</body>
</html>