@using Microsoft.AspNetCore.Identity
@using ApartmentManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var buildingId = UserManager.GetUserAsync(User).Result?.BuildingId;
    bool isOwner = User.IsInRole("Owner");
    bool isPresident = User.IsInRole("President");
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="//cdn.datatables.net/2.3.1/css/dataTables.dataTables.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    @* top navbar *@
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3" href="#">Apartment Management</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#sidebarMenu"
                aria-controls="sidebarMenu"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-nav">
            <div id="logout-section-1" class="nav-item text-nowrap">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    @* sidebar and main content area *@
    <div class="container-fluid">
        <div class="row">
            @* sidebar *@
            <nav id="sidebarMenu"
                 class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
                <div class="position-sticky pt-3 sidebar-sticky">
                    <ul class="nav flex-column">

                        @* ---------- SuperAdmin Urls ---------- *@
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="SuperAdmin" asp-action="Dashboard">
                                    <i class="bi bi-speedometer me-1"></i>
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Approvals">
                                    <i class="bi bi-people me-1"></i>
                                    Pending Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                    <i class="bi bi-people me-1"></i>
                                    Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="CreateUser">
                                    <i class="bi bi-people me-1"></i>
                                    Create User
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="AssignPresident">
                                    <i class="bi bi-p-circle me-1"></i>
                                    Assign President
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Building" asp-action="Index">
                                    <i class="bi bi-buildings me-1"></i>
                                    Buildings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Flat" asp-action="AllFlats">
                                    <i class="fa-regular fa-house me-1"></i>
                                    Flats
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="EntryLog" asp-action="Index">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Entry Logs
                                </a>
                            </li>
                        }

                        @* ---------- President Urls ---------- *@
                        @if (User.IsInRole("President"))
                        {
                            <p class="ms-2"><strong>President Dasboard</strong></p>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="President" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Approvals">
                                    <i class="bi bi-people me-1"></i>
                                    Pending Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                    <i class="bi bi-people me-1"></i>
                                    Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="CommonBill" asp-action="Index" asp-route-buildingId="@buildingId">
                                    <i class="fa-solid fa-file-invoice-dollar me-1"></i>
                                    Common Bills
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="OwnerBilling" asp-action="Index" asp-route-buildingId="@buildingId">
                                    <i class="bi bi-coin"></i>
                                    Owner Bills
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ExpensePayment" asp-action="Index" asp-route-buildingId="@buildingId">
                                    <i class="fa-solid fa-money-check-dollar me-1"></i>
                                    Bill Pay
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Flat" asp-action="AllFlats">
                                    <i class="fa-regular fa-house me-1"></i>
                                    Flats
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Tenant" asp-action="BuildingTenants">
                                    <i class="fas fa-users me-1"></i>
                                    Tenants
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Announcement" asp-action="Index">
                                    <i class="bi bi-megaphone me-1"></i> Announcements
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Maintenance" asp-action="Index">
                                    <i class="bi bi-tools me-1"></i> Maintenance
                                </a>
                            </li>
                            <hr />
                            <p class="ms-2"><strong>Reports</strong></p>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PresidentReports" asp-action="Financial"><i class="bi bi-cash-coin me-1"></i> Financial Report</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PresidentReports" asp-action="Occupancy"><i class="bi bi-house-door me-1"></i> Occupancy Report</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PresidentReports" asp-action="Visitors"><i class="bi bi-people me-1"></i> Visitor Report</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PresidentReports" asp-action="Maintenance"><i class="bi bi-tools me-1"></i> Maintenance Report</a>
                            </li>

                            <hr />
                            <p class="ms-2"><strong>Owner Dasboard</strong></p>
                        }

                        @* ---------- Owner Urls ---------- *@
                        @if (User.IsInRole("Owner"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Owner" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Admin" asp-action="CreateUser">
                                    Create Tenant
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="TenantAssignment" asp-action="MyTenants">
                                    My Tenants
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Owner" asp-action="OwnedFlats">
                                    My Flats
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="TenantAssignment" asp-action="Assign">
                                    Assign Tenant to Flat
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="FlatBillingProfile" asp-action="Index">
                                    Flat Billing Profiles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="TenantRent" asp-action="List">
                                    Tenant Rent
                                </a>
                            </li>

                            @* <li class="nav-item">
                                <a class="nav-link" asp-controller="Owner" asp-action="MyFlats">
                                    <i class="fa-solid fa-home me-1"></i>
                                    My Flats
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Owner" asp-action="MyTenants">
                                    <i class="fas fa-users me-1"></i>
                                    My Tenants
                                </a>
                            </li> *@
                            <hr />
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="EntryLog" asp-action="Index">
                                    <i class="fa-solid fa-person-walking-dashed-line-arrow-right me-1"></i>
                                    Entry Logs
                                </a>
                            </li>
                        }

                        @* ---------- Tenant Urls ---------- *@
                        @if (User.IsInRole("Tenant"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> My Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Bills">
                                    <i class="fa-solid fa-file-invoice-dollar me-1"></i> My Bills
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Payments">
                                    <i class="fa-solid fa-file-invoice-dollar me-1"></i> My Payments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Notices">
                                    <i class="bi bi-megaphone me-1"></i> Notices
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Tickets">
                                    <i class="bi bi-tools me-1"></i> Maintenance Tickets
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TenantPortal" asp-action="Visitors">
                                    <i class="bi bi-people me-1"></i> Visitors
                                </a>
                            </li>
                        }

                        @* ---------- Staff Urls ---------- *@
                        @if (User.IsInRole("Staff"))
                        {
                            <p class="ms-2"><strong>Staff</strong></p>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="EntryLog" asp-action="Index">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Entry Logs
                                </a>
                            </li>
                        }
                        <hr />
                        <li class="nav-item" id="logout-section-2">
                            <form id="logoutForm" class="form-inline nav-link" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button id="logout" type="submit" class="btn px-0">
                                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                    Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </nav>

            @* main content area *@
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 my-md-3">
                @* <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"> *@
                <div class="">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
    <script src="//cdn.datatables.net/2.3.1/js/dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>