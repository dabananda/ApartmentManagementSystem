@using ApartmentManagementSystem.ViewModels.Flat
@model List<FlatProfileRow>
@{
    ViewData["Title"] = "Flat Billing Profiles";
}
<h2>Flat Billing Profiles</h2>
<table class="table table-striped">
    <thead><tr><th>Flat</th><th>Title</th><th>Amount</th><th>Due Day</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.FlatNumber</td>
                <td>@(r.HasProfile? r.Title: "-")</td>
                <td>@(r.HasProfile? r.Amount.ToString("C") : "-")</td>
                <td>@(r.HasProfile? r.DueDay.ToString() : "-")</td>
                <td>@(r.HasProfile ? (r.IsActive ? "Active" : "Inactive") : "-")</td>
                <td><a asp-action="Edit" asp-route-flatId="@r.FlatId" class="btn btn-sm btn-primary">Edit</a></td>
            </tr>
        }
    </tbody>
</table>
