@model IEnumerable<ApartmentManagementSystem.Domain.Entities.EntryLog>
@{
    ViewData["Title"] = "Visitors";
    var fromVal = (string?)Context.Request?.Query["from"];
    var toVal = (string?)Context.Request?.Query["to"];
}
<h1 class="mb-3">Visitors to My Flat</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="date" name="from" class="form-control" value="@fromVal" />
    </div>
    <div class="col-auto">
        <input type="date" name="to" class="form-control" value="@toVal" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">Filter</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No visitors found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th class="text-end"># Persons</th>
                    <th>Purpose</th>
                    <th>Exited</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td>@v.EntryTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @v.Fullname @if(!string.IsNullOrWhiteSpace(v.PhoneNumber)){
                            <text>(@v.PhoneNumber)</text>
                        }
                    </td>
                    <td>@v.EntryType</td>
                    <td class="text-end">@v.NumberOfPerson</td>
                    <td>@v.Purpose</td>
                    <td>@(v.ExitTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
}
