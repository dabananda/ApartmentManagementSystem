@using ApartmentManagementSystem.ViewModels.TenantPortal
@model List<TenantPaymentRow>
@{
    ViewData["Title"] = "My Payments";
}
<h2>My Payments</h2>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Date</th>
            <th>Bill</th>
            <th>Building / Flat</th>
            <th class="text-end">Amount</th>
            <th>Ref</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                <td>@p.BillTitle (@p.BillDate.ToString("yyyy-MM"))</td>
                <td>@p.BuildingName / @p.FlatNumber</td>
                <td class="text-end">@p.Amount.ToString("C")</td>
                <td>@(string.IsNullOrWhiteSpace(p.Reference) ? "-" : p.Reference)</td>
            </tr>
        }
    </tbody>
</table>
