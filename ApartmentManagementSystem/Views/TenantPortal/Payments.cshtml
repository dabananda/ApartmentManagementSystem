@model IEnumerable<ApartmentManagementSystem.Models.Rent>
@{
    ViewData["Title"] = "My Payments";
}
<h1 class="mb-3">My Payment History</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">No payments recorded yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th class="text-end">Amount</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.PaymentDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@r.Amount.ToString("C")</td>
                        <td>@r.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
