@model List<ApartmentManagementSystem.Models.Announcement>
@{
    ViewData["Title"] = "Notices";
}
<h2>Notices</h2>

@if (!Model.Any())
{
    <div class="text-muted">No notices published yet.</div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <h5 class="mb-1">@n.Title</h5>
                    <small class="text-muted">@n.CreatedAt.ToString("yyyy-MM-dd")</small>
                </div>
                <p class="mb-1">@n.Body</p>
            </div>
        }
    </div>
}
