@using ApartmentManagementSystem.Application.Features.Administration.DTOs
@model SuperAdminDashboardViewModel
@{
    ViewData["Title"] = "SuperAdmin Dashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 dashboard-card-title text-uppercase" style="font-size:1.1rem; color:#1D1D1F;">SuperAdmin Dashboard</h1>
        <div class="btn-group gap-2" role="group">
            <a asp-controller="Admin" asp-action="CreateUser" class="btn btn-primary">
                <i class="fas fa-user-plus me-1"></i> Create User
            </a>
            <a asp-controller="Building" asp-action="Create" class="btn btn-dark">
                <i class="fas fa-building me-1"></i> Add Building
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-card h-100">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="dashboard-card-title">Total Buildings</div>
                        <div class="dashboard-card-value">@Model.TotalBuildings</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-building dashboard-card-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-card h-100">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="dashboard-card-title">Total Users</div>
                        <div class="dashboard-card-value">@Model.TotalUsers</div>
                        <small class="text-muted d-block mt-1">Owners: @Model.TotalOwners | Tenants: @Model.TotalTenants</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-users dashboard-card-icon" style="color:var(--bs-success);"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-card h-100">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="dashboard-card-title">Flats</div>
                        <div class="dashboard-card-value">@Model.TotalFlats</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-home dashboard-card-icon" style="color:var(--bs-info);"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="dashboard-card h-100">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="dashboard-card-title">Financial Balance</div>
                        <div class="dashboard-card-value" style="font-size:1.6rem;">@Model.OverallBalance.ToString("C")</div>
                        <small class="text-muted d-block mt-1">Collected: @Model.TotalAmountCollected.ToString("C")</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-dollar-sign dashboard-card-icon" style="color:var(--bs-warning);"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Financial Overview</h6>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-sm-6 col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Bills Generated</div>
                            <div class="h6 mb-0">@Model.TotalBillsGenerated.ToString("C")</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Amount Collected</div>
                            <div class="h6 mb-0">@Model.TotalAmountCollected.ToString("C")</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Payments Made</div>
                            <div class="h6 mb-0">@Model.TotalPaymentsMade.ToString("C")</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="card @(Model.TotalPendingCollection > 0 ? "bg-warning" : "bg-secondary") text-white">
                        <div class="card-body">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Pending Collection</div>
                            <div class="h6 mb-0">@Model.TotalPendingCollection.ToString("C")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="text-primary">Recent Bills</h6>
                </div>
                <div class="card-body">
                    <h6 class="text-primary">Recent Bills</h6>
                    <div class="list-group list-group-flush mb-3">
                        @if (Model.RecentBills.Any())
                        {
                            @foreach (var bill in Model.RecentBills)
                            {
                                <div class="list-group-item list-group-item-action flex-column align-items-start">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@bill.Name</h6>
                                        <small>@bill.BillDate.ToString("MMM dd")</small>
                                    </div>
                                    <p class="mb-1">@(bill.Building?.Name ?? "Unknown Building")</p>
                                    <small class="text-success font-weight-bold">@bill.TotalAmount.ToString("C")</small>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="list-group-item">
                                <small class="text-muted">No recent bills</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="text-primary">Recent Payments</h6>
                </div>
                <div class="card-body">
                    <h6 class="text-primary">Recent Payments</h6>
                    <div class="list-group list-group-flush">
                        @if (Model.RecentPayments.Any())
                        {
                            @foreach (var payment in Model.RecentPayments)
                            {
                                <div class="list-group-item list-group-item-action flex-column align-items-start">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@payment.Name</h6>
                                        <small>@payment.PaymentDate.ToString("MMM dd")</small>
                                    </div>
                                    <p class="mb-1">@(payment.Building?.Name ?? "Unknown Building")</p>
                                    <small class="text-primary font-weight-bold">@payment.Amount.ToString("C")</small>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="list-group-item">
                                <small class="text-muted">No recent payments</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


