@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Email Confirmed";
    Layout = null;
}

<style>
    .confirmation-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        height: 96vh;
        display: flex;
        align-items: center;
        justify-content: center;
        /* background: linear-gradient(135deg, #10b981 0%, #059669 100%); */
        position: relative;
        overflow: hidden;
    }

    .confetti {
        position: absolute;
        width: 10px;
        height: 10px;
        background: #fbbf24;
        position: absolute;
        animation: confetti-fall 3s linear infinite;
    }

    @@keyframes confetti-fall {
        to {
            transform: translateY(100vh) rotate(360deg);
            opacity: 0;
        }
    }

    .confetti:nth-child(1) {
        left: 10%;
        animation-delay: 0s;
        background: #fbbf24;
    }

    .confetti:nth-child(2) {
        left: 20%;
        animation-delay: 0.3s;
        background: #f472b6;
    }

    .confetti:nth-child(3) {
        left: 30%;
        animation-delay: 0.6s;
        background: #60a5fa;
    }

    .confetti:nth-child(4) {
        left: 40%;
        animation-delay: 0.9s;
        background: #a78bfa;
    }

    .confetti:nth-child(5) {
        left: 50%;
        animation-delay: 1.2s;
        background: #34d399;
    }

    .confetti:nth-child(6) {
        left: 60%;
        animation-delay: 1.5s;
        background: #fb923c;
    }

    .confetti:nth-child(7) {
        left: 70%;
        animation-delay: 1.8s;
        background: #f472b6;
    }

    .confetti:nth-child(8) {
        left: 80%;
        animation-delay: 2.1s;
        background: #60a5fa;
    }

    .confetti:nth-child(9) {
        left: 90%;
        animation-delay: 2.4s;
        background: #fbbf24;
    }

    .confirmation-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.3);
        padding: 3.5rem 3rem;
        max-width: 550px;
        width: 100%;
        text-align: center;
        animation: slideUp 0.8s ease-out;
        position: relative;
        z-index: 10;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(40px) scale(0.9);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .success-icon {
        width: 120px;
        height: 120px;
        margin: 0 auto 2rem;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        animation: scaleIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.4);
    }

    @@keyframes scaleIn {
        0% {
            transform: scale(0) rotate(-180deg);
            opacity: 0;
        }

        60% {
            transform: scale(1.2) rotate(10deg);
        }

        100% {
            transform: scale(1) rotate(0);
            opacity: 1;
        }
    }

    .success-icon::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: #10b981;
        animation: ripple 2s ease-out infinite;
        opacity: 0;
    }

    @@keyframes ripple {
        0% {
            transform: scale(1);
            opacity: 0.6;
        }

        100% {
            transform: scale(1.6);
            opacity: 0;
        }
    }

    .success-icon svg {
        width: 60px;
        height: 60px;
        fill: none;
        stroke: white;
        stroke-width: 4;
        stroke-linecap: round;
        stroke-linejoin: round;
        position: relative;
        z-index: 2;
    }

    .checkmark {
        stroke-dasharray: 100;
        stroke-dashoffset: 100;
        animation: drawCheck 0.8s ease-out 0.4s forwards;
    }

    @@keyframes drawCheck {
        to {
            stroke-dashoffset: 0;
        }
    }

    .confirmation-card h1 {
        font-size: 2.5rem;
        font-weight: 800;
        color: #1f2937;
        margin-bottom: 1rem;
        animation: fadeIn 0.8s ease-out 0.3s both;
    }

    .confirmation-card .subtitle {
        font-size: 1.2rem;
        color: #10b981;
        font-weight: 600;
        margin-bottom: 1.5rem;
        animation: fadeIn 0.8s ease-out 0.5s both;
    }

    .confirmation-card p {
        font-size: 1.1rem;
        color: #6b7280;
        line-height: 1.7;
        margin-bottom: 2rem;
        animation: fadeIn 0.8s ease-out 0.7s both;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .success-features {
        display: grid;
        gap: 1rem;
        margin: 2rem 0;
        animation: fadeIn 0.8s ease-out 0.9s both;
    }

    .cta-button {
        display: inline-block;
        margin-top: 1.5rem;
        padding: 1rem 2.5rem;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        text-decoration: none;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
        animation: fadeIn 0.8s ease-out 1.1s both;
    }

        .cta-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.5);
        }

    .error-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.3);
        padding: 3.5rem 3rem;
        max-width: 550px;
        width: 100%;
        text-align: center;
        animation: slideUp 0.8s ease-out;
    }

    .error-icon {
        width: 120px;
        height: 120px;
        margin: 0 auto 2rem;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: scaleIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        box-shadow: 0 10px 30px rgba(239, 68, 68, 0.4);
    }

        .error-icon svg {
            width: 60px;
            height: 60px;
            stroke: white;
            fill: none;
            stroke-width: 4;
            stroke-linecap: round;
        }

    .error-card h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #ef4444;
        margin-bottom: 1rem;
    }

    .error-card p {
        font-size: 1.1rem;
        color: #6b7280;
        line-height: 1.7;
    }
</style>

<div class="confirmation-container">
    @for (int i = 0; i < 9; i++)
    {
        <div class="confetti"></div>
    }

    @if (Model.StatusMessage == null || Model.StatusMessage.Contains("Thank you"))
    {
        <div class="confirmation-card">
            <div class="success-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                    <path class="checkmark" d="M14 27l7 7 16-16" />
                </svg>
            </div>

            <h1>You're All Set!</h1>
            <div class="subtitle">Email Successfully Verified</div>
            <p>Your email address has been confirmed. Your account is now fully activated and ready to use.</p>

            <a href="/Identity/Account/Login" class="cta-button">Continue to Login</a>
        </div>
    }
    else
    {
        <div class="error-card">
            <div class="error-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="15" y1="9" x2="9" y2="15" />
                    <line x1="9" y1="9" x2="15" y2="15" />
                </svg>
            </div>

            <h1>Verification Failed</h1>
            <p>@Model.StatusMessage</p>
            <p style="margin-top: 1.5rem; font-size: 1rem;">Please try again or contact support if the problem persists.</p>

            <a href="/Identity/Account/Register" class="cta-button" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);">Back to Registration</a>
        </div>
    }
</div>
