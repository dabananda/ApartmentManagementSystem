@using AMS.Application.Features.Tenancy.DTOs
@model ReceiptViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Receipt";
}

<style>
    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }
</style>


<div class="receipt-card card shadow-sm mt-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h4 class="mb-0">Payment Receipt</h4>
                <div class="text-muted">Receipt No: <strong>@Model.ReceiptNo</strong></div>
            </div>
            <button class="btn btn-outline-secondary no-print" onclick="window.print()">Print</button>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="mb-1"><strong>Owner:</strong> @Model.OwnerName</div>
                <div class="text-muted">@Model.OwnerEmail</div>
            </div>
            <div class="col-md-6 text-md-end">
                <div class="mb-1"><strong>Paid On:</strong> @Model.PaidOn.ToString("yyyy-MM-dd")</div>
                <div class="mb-1"><strong>Amount:</strong> @Model.Amount.ToString("C")</div>
                <div class="mb-1"><strong>Reference:</strong> @(string.IsNullOrWhiteSpace(Model.Reference) ? "-" : Model.Reference)</div>
            </div>
        </div>
        <hr />
        <div>
            <div class="mb-1"><strong>Bill:</strong> @Model.BillTitle</div>
            <div class="mb-1"><strong>Bill Date:</strong> @Model.BillDate.ToString("yyyy-MM-dd")</div>
        </div>
        <hr />
        <div class="text-muted small">
            If you have questions about this receipt, please reply to this email or contact the building management office.
        </div>
    </div>
</div>
