@using AMS.Application.Features.Administration.DTOs
@model AssignPresidentViewModel
@{
    ViewData["Title"] = "Assign President";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <div class="card">
            <div class="card-header text-center">
                <h3 class="card-title">Assign President</h3>
            </div>
            <div class="card-body">
                <form method="post" asp-controller="Admin" asp-action="AssignPresident" class="row g-3">
                    @Html.AntiForgeryToken()

                    <div class="col-md-6">
                        <label asp-for="BuildingId" class="form-label"></label>
                        <select asp-for="BuildingId" class="form-select" asp-items="Model.Buildings" id="BuildingId">
                            <option value="">-- Select a building --</option>
                        </select>
                        <span asp-validation-for="BuildingId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="OwnerUserId" class="form-label"></label>
                        <select asp-for="OwnerUserId" class="form-select" asp-items="Model.Owners" id="OwnerUserId">
                            <option value="">-- Select an owner --</option>
                        </select>
                        <span asp-validation-for="OwnerUserId" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="row">
                            <div class="col">
                                <a asp-action="Users" asp-controller="Admin" class="btn btn-secondary w-100">Back to Admin Panel</a>
                            </div>
                            <div class="col text-end">
                                <button class="btn btn-primary w-100" type="submit">Assign President</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const buildingSelect = document.getElementById('BuildingId');
            const ownerSelect = document.getElementById('OwnerUserId');

            async function loadOwnersFor(buildingId) {
                ownerSelect.innerHTML = '<option value="">-- Select an owner --</option>';

                if (!buildingId) return;

                try {
                    const url = '@Url.Action("OwnersForBuilding", "Admin")' + '?buildingId=' + encodeURIComponent(buildingId);
                    const res = await fetch(url, { method: 'GET', headers: { 'Accept': 'application/json' } });
                    if (!res.ok) throw new Error('Failed to fetch owners');

                    const owners = await res.json();
                    owners.forEach(o => {
                        const opt = document.createElement('option');
                        opt.value = o.value;
                        opt.textContent = o.text;
                        ownerSelect.appendChild(opt);
                    });
                } catch (e) {
                    console.error(e);
                }
            }

            if (buildingSelect && buildingSelect.value) {
                loadOwnersFor(buildingSelect.value);
            }

            buildingSelect?.addEventListener('change', function (e) {
                loadOwnersFor(e.target.value);
            });
        })();
    </script>

    <script>
        (function(){
            if (!window.SwalHelpers) return;
            SwalHelpers.bindConfirm("form[asp-action='AssignPresident'] button[type='submit']",
                { title: 'Assign selected owner as President?', text: 'This will update roles and approve the user.', icon: 'question', confirmText: 'Assign' });
        })();
    </script>
}
