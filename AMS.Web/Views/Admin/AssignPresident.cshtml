@using AMS.Application.Features.Administration.DTOs
@model AssignPresidentViewModel
@{
    ViewData["Title"] = "Assign President";
}

<style>
    .modern-card {
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid rgba(0,0,0,0.08);
        box-shadow: 0 20px 40px rgba(94, 92, 230, 0.1);
        overflow: hidden;
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .card-header-premium {
        background: linear-gradient(135deg, #5E5CE6 0%, #BF5AF2 100%);
        color: white;
        padding: 30px 20px;
        text-align: center;
        border-bottom: none;
    }
    .card-header-premium h3 {
        font-weight: 700;
        margin: 0;
        font-size: 1.5rem;
        letter-spacing: -0.02em;
    }
    .card-body-premium {
        padding: 40px;
    }
    .form-label {
        font-weight: 600;
        color: #1D1D1F;
        margin-bottom: 8px;
    }
    .form-select-modern {
        border-radius: 12px;
        padding: 12px 16px;
        border: 1px solid #d2d2d7;
        transition: all 0.3s;
        background-color: #f5f5f7;
    }
    .form-select-modern:focus {
        background-color: #ffffff;
        border-color: #5E5CE6;
        box-shadow: 0 0 0 4px rgba(94, 92, 230, 0.1);
    }
    .btn-premium {
        background: #5E5CE6;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 30px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 14px rgba(94, 92, 230, 0.3);
    }
    .btn-premium:hover {
        background: #4e4bdc;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(94, 92, 230, 0.4);
        color: white;
    }
    .btn-outline-modern {
        border: 1px solid #d2d2d7;
        color: #1D1D1F;
        padding: 12px 24px;
        border-radius: 30px;
        font-weight: 500;
        transition: all 0.3s ease;
        background: transparent;
    }
    .btn-outline-modern:hover {
        background: #f5f5f7;
        color: #1D1D1F;
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="row py-4">
    <div class="col-lg-8 col-xl-6 offset-lg-2 offset-xl-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 shadow-sm mb-4 border-0">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 shadow-sm mb-4 border-0">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }

        <div class="modern-card">
            @* <div class="card-header-premium">
                <div class="mb-2" style="font-size: 2.5rem; opacity: 0.9;">
                    <i class="fas fa-user-tie"></i>
                </div>
                <h3 class="card-title">Assign President</h3>
                <p class="text-white-50 mb-0 mt-2 small">Select a building and assign an owner as its president.</p>
            </div> *@
            <div class="card-body-premium">
                <form method="post" asp-controller="Admin" asp-action="AssignPresident">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="BuildingId" class="form-label">Building</label>
                        <select asp-for="BuildingId" class="form-select form-select-modern" asp-items="Model.Buildings" id="BuildingId">
                            <option value="">-- Select a building --</option>
                        </select>
                        <span asp-validation-for="BuildingId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="OwnerUserId" class="form-label">Owner</label>
                        <select asp-for="OwnerUserId" class="form-select form-select-modern" asp-items="Model.Owners" id="OwnerUserId">
                            <option value="">-- Select an owner --</option>
                        </select>
                        <span asp-validation-for="OwnerUserId" class="text-danger small mt-1 d-block"></span>
                        <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Only approved owners are listed.</div>
                    </div>

                    <div class="d-flex gap-3 pt-2">
                        <a asp-action="Users" asp-controller="Admin" class="btn btn-outline-modern w-50 text-center text-decoration-none">Cancel</a>
                        <button class="btn btn-premium w-50" type="submit">Assign President</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const buildingSelect = document.getElementById('BuildingId');
            const ownerSelect = document.getElementById('OwnerUserId');

            async function loadOwnersFor(buildingId) {
                ownerSelect.innerHTML = '<option value="">-- Select an owner --</option>';

                if (!buildingId) return;

                try {
                    const url = '@Url.Action("OwnersForBuilding", "Admin")' + '?buildingId=' + encodeURIComponent(buildingId);
                    const res = await fetch(url, { method: 'GET', headers: { 'Accept': 'application/json' } });
                    if (!res.ok) throw new Error('Failed to fetch owners');

                    const owners = await res.json();
                    owners.forEach(o => {
                        const opt = document.createElement('option');
                        opt.value = o.value;
                        opt.textContent = o.text;
                        ownerSelect.appendChild(opt);
                    });
                } catch (e) {
                    console.error(e);
                }
            }

            if (buildingSelect && buildingSelect.value) {
                loadOwnersFor(buildingSelect.value);
            }

            buildingSelect?.addEventListener('change', function (e) {
                loadOwnersFor(e.target.value);
            });
        })();
    </script>

    <script>
        (function(){
            if (!window.SwalHelpers) return;
            SwalHelpers.bindConfirm("form[asp-action='AssignPresident'] button[type='submit']",
                { title: 'Assign selected owner as President?', text: 'This will update roles and approve the user.', icon: 'question', confirmText: 'Assign' });
        })();
    </script>
}
