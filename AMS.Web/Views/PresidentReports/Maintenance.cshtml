@model AMS.Application.Features.Reports.DTOs.MaintenanceReportViewModel
@{
    ViewData["Title"] = "Maintenance Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Maintenance Report — @Model.BuildingName</h2>
    <a asp-action="MaintenanceCsv" asp-route-from="@Model.Filter.From?.ToString("yyyy-MM-dd")"
       asp-route-to="@Model.Filter.To?.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">Export CSV</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="From" class="form-control" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="To" class="form-control" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto align-self-end"><button class="btn btn-primary">Apply</button></div>
</form>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Open</div><div class="h4">@Model.OpenCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">In Progress</div><div class="h4">@Model.InProgressCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Closed</div><div class="h4">@Model.ClosedCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Avg Resolution</div>
                <div class="h5">@((Model.AvgResolutionHours ?? 0).ToString("0.0")) h</div>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info">
    <strong>In range:</strong>
    <span class="me-3">Created: @Model.NewlyCreated</span>
    <span>Closed: @Model.ClosedInRange</span>
</div>

<div class="card shadow mb-3">
    <div class="card-header"><strong>Tickets by Status</strong></div>
    <div class="card-body"><canvas id="maintBars" height="120"></canvas></div>
</div>

@section Scripts {
    <script>
        (function() {
          var labels = ['Open', 'In Progress', 'Closed'];
          var counts = [@Model.OpenCount, @Model.InProgressCount, @Model.ClosedCount];
          var ctx = document.getElementById('maintBars').getContext('2d');
          new Chart(ctx, {
            type: 'bar',
            data: {
              labels: labels,
              datasets: [{
                label: 'Tickets',
                data: counts,
                backgroundColor: ['rgba(255,205,86,0.6)','rgba(54,162,235,0.6)','rgba(75,192,192,0.6)'],
                borderColor:   ['rgba(255,205,86,1)','rgba(54,162,235,1)','rgba(75,192,192,1)'],
                borderWidth: 1
              }]
            },
            options: { scales: { yAxes: [{ ticks: { beginAtZero: true, precision: 0 } }] } }
          });
        })();
    </script>
}
