@model List<AMS.Domain.Entities.MaintenanceTicket>
@{
    ViewData["Title"] = "My Tickets";
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="mb-0">My Maintenance Tickets</h2>
    <a asp-action="NewTicket" class="btn btn-sm btn-primary">Open Ticket</a>
</div>

@if (!Model.Any())
{
    <div class="text-muted">No tickets yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Created</th><th>Title</th><th>Description</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@t.Title</td>
                    <td>@t.Description</td>
                    <td>@t.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
