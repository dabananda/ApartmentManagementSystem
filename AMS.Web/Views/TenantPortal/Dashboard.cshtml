@using AMS.Application.Features.TenantPortal.DTOs
@model TenantDashboardVM
@{
    ViewData["Title"] = "My Dashboard";
}

<h2 class="mb-1">Welcome, @Model.TenantName</h2>
<div class="text-muted mb-3">@Model.BuildingName — Flat @Model.FlatNumber</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Billed</div>
                <div class="h4 mb-0">@Model.TotalBilled.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Paid</div>
                <div class="h4 mb-0 text-success">@Model.TotalPaid.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Due</div>
                <div class="h4 mb-0 @(Model.TotalDue > 0 ? "text-danger" : "text-success")">@Model.TotalDue.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Paid This Month</div>
                <div class="h4 mb-0">@Model.PaidThisMonth.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Recent Bills</strong>
                <a asp-action="Bills" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body">
                @if (!Model.RecentBills.Any())
                {
                    <div class="text-muted">No bills.</div>
                }
                else
                {
                    <table class="table table-sm table-striped align-middle">
                        <thead><tr><th>Date</th><th>Title</th><th class="text-end">Amt</th><th class="text-end">Due</th></tr></thead>
                        <tbody>
                            @foreach (var b in Model.RecentBills)
                            {
                                <tr>
                                    <td>@b.BillDate.ToString("yyyy-MM-dd")</td>
                                    <td>@b.Title</td>
                                    <td class="text-end">@b.Amount.ToString("C")</td>
                                    <td class="text-end">@b.Due.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Recent Payments</strong>
                <a asp-action="Payments" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body">
                @if (!Model.RecentPayments.Any())
                {
                    <div class="text-muted">No payments.</div>
                }
                else
                {
                    <table class="table table-sm table-striped align-middle">
                        <thead><tr><th>Date</th><th>Bill</th><th class="text-end">Amount</th><th>Ref</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.RecentPayments)
                            {
                                <tr>
                                    <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                                    <td>@p.BillTitle</td>
                                    <td class="text-end">@p.Amount.ToString("C")</td>
                                    <td>@(string.IsNullOrWhiteSpace(p.Reference) ? "-" : p.Reference)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Recent Notices</strong>
                <a asp-action="Notices" class="btn btn-sm btn-outline-secondary">All Notices</a>
            </div>
            <div class="card-body">
                @if (!Model.RecentNotices.Any())
                {
                    <div class="text-muted">No notices published yet.</div>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var n in Model.RecentNotices)
                        {
                            <li><strong>@n.Title</strong> <small class="text-muted">(@n.CreatedAt.ToString("yyyy-MM-dd"))</small></li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
