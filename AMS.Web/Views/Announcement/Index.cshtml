@model IEnumerable<AMS.Domain.Entities.Announcement>
@{
    ViewData["Title"] = "Announcements";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Announcements</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-megaphone"></i> New Announcement</a>
</div>

<div class="list-group">
    @foreach (var a in Model)
    {
        <div class="list-group-item">
            <div class="d-flex justify-content-between">
                <strong>@a.Title</strong>
                <small class="text-muted">@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
            </div>
            <div>@a.Body</div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="text-muted">No announcements yet.</div>
    }
</div>
