@model AMS.Domain.Entities.EntryLog

@{
    ViewData["Title"] = "Delete Entry Log";
}

<div class="container">
    <div class="row mb-3">
        <div class="col-8">
            <h3 class="h4">Confirm Deletion</h3>
            <p class="text-muted">Are you sure you want to delete this entry? This action cannot be undone.</p>
        </div>
        <div class="col-4 text-end">
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Fullname</dd>

                <dt class="col-sm-3">Building / Flat</dt>
                <dd class="col-sm-9">@Model.Building?.Name - @Model.Flat?.FlatNumber</dd>

                <dt class="col-sm-3">Entry Time</dt>
                <dd class="col-sm-9">@Model.EntryTime.ToString("yyyy-MM-dd hh:mm tt")</dd>

                <dt class="col-sm-3">Exit Time</dt>
                <dd class="col-sm-9">@(Model.ExitTime.HasValue ? Model.ExitTime.Value.ToString("yyyy-MM-dd hh:mm tt") : "-")</dd>
            </dl>
        </div>
        <div class="card-footer text-end">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </div>
</div>
