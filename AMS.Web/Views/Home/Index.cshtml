@model AMS.Application.Features.Home.DTOs.ContactViewModel
@{
    ViewData["Title"] = "Apartment Management System";
    ViewData["HideSidebar"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* Specific overrides for layout to remove padding constraints if any */
    body {
        padding-top: 0 !important;
        background-color: #ffffff !important;
    }
    .content-wrapper {
        padding: 0 !important;
        max-width: 100% !important;
    }
    .navbar {
        position: fixed;
        width: 100%;
        z-index: 1000;
        transition: all 0.3s ease;
    }
    .navbar-scrolled {
        background: rgba(255, 255, 255, 0.8) !important;
        backdrop-filter: blur(12px);
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }
</style>

<!-- Hero Section -->
<section class="hero-modern text-center position-relative">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    
    <div class="container position-relative z-index-2 fade-up">
        <h1 class="hero-title">
            Manage your apartments with<br/>
            <span class="text-gradient">absolute clarity.</span>
        </h1>
        <p class="hero-subtitle">
            The elegant, powerful, and ridiculously easy way to handle billing, maintenance, and residents. Built for modern property managers.
        </p>
        
        <div class="d-flex gap-3 justify-content-center mb-5">
            <a href="/Identity/Account/Login" class="btn btn-premium">Get Started</a>
            <a href="#features" class="btn btn-outline-premium">Explore Features</a>
        </div>

        @* <div class="hero-mockup-wrapper fade-up" style="transition-delay: 0.2s;">
            <img src="/images/dashboard_mockup.png" 
                 alt="AMS Dashboard Preview" 
                 class="hero-mockup img-fluid" />
        </div> *@
    </div>
</section>

<!-- Features Section -->
<section class="section-padding bg-subtle" id="features">
    <div class="container text-center">
        <h2 class="section-title fade-up">Everything you need. Beautifully designed.</h2>
        <p class="section-subtitle fade-up">
            Say goodbye to endless spreadsheets and messy group chats. AMS streamlines your entire workflow into one intuitive dashboard.
        </p>

        <div class="row g-4 mt-5 text-start">
            <!-- Feature 1 -->
            <div class="col-lg-4 col-md-6 fade-up">
                <div class="modern-card">
                    <div class="card-icon icon-purple">
                        <i class="bi bi-calculator"></i>
                    </div>
                    <h4>Smart Billing Engine</h4>
                    <p>Generate complex bills in seconds. Split costs by unit, percentage, or custom rules effortlessly.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2-circle"></i> Automated calculations</li>
                        <li><i class="bi bi-check2-circle"></i> Multiple billing methods</li>
                        <li><i class="bi bi-check2-circle"></i> Instant PDF generation</li>
                    </ul>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="col-lg-4 col-md-6 fade-up" style="transition-delay: 0.1s;">
                <div class="modern-card">
                    <div class="card-icon icon-blue">
                        <i class="bi bi-phone"></i>
                    </div>
                    <h4>Resident Portal</h4>
                    <p>Let residents check their dues, payment history, and notices 24/7. Cut your support calls by 80%.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2-circle"></i> Self-service access</li>
                        <li><i class="bi bi-check2-circle"></i> Mobile optimized</li>
                        <li><i class="bi bi-check2-circle"></i> Secure stripe payments</li>
                    </ul>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="col-lg-4 col-md-6 fade-up" style="transition-delay: 0.2s;">
                <div class="modern-card">
                    <div class="card-icon icon-pink">
                        <i class="bi bi-bar-chart"></i>
                    </div>
                    <h4>Financial Insights</h4>
                    <p>Beautiful charts and reports that actually make sense. Impress your committee with professional presentations.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2-circle"></i> Visual dashboards</li>
                        <li><i class="bi bi-check2-circle"></i> Exportable reports</li>
                        <li><i class="bi bi-check2-circle"></i> Trend analysis</li>
                    </ul>
                </div>
            </div>

            <!-- Feature 4 -->
            <div class="col-lg-4 col-md-6 fade-up">
                <div class="modern-card">
                    <div class="card-icon icon-orange">
                        <i class="bi bi-wrench"></i>
                    </div>
                    <h4>Maintenance Ticketing</h4>
                    <p>Track repairs from request to resolution. Keep everyone informed without the endless phone calls.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2-circle"></i> Photo uploads</li>
                        <li><i class="bi bi-check2-circle"></i> Status tracking</li>
                        <li><i class="bi bi-check2-circle"></i> Vendor management</li>
                    </ul>
                </div>
            </div>

            <!-- Feature 5 -->
            <div class="col-lg-4 col-md-6 fade-up" style="transition-delay: 0.1s;">
                <div class="modern-card">
                    <div class="card-icon icon-green">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4>Visitor & Gate Pass</h4>
                    <p>Enhance security with digital entry logs. Instantly know who is entering and leaving the premises.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2-circle"></i> Digital visitor logs</li>
                        <li><i class="bi bi-check2-circle"></i> Instant notifications</li>
                        <li><i class="bi bi-check2-circle"></i> Historical records</li>
                    </ul>
                </div>
            </div>

            <!-- Feature 6 -->
            <div class="col-lg-4 col-md-6 fade-up" style="transition-delay: 0.2s;">
                <div class="modern-card">
                    <div class="card-icon icon-purple">
                        <i class="bi bi-megaphone"></i>
                    </div>
                    <h4>Notice Board</h4>
                    <p>Broadcast announcements instantly to all residents or specific buildings via email and the portal.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2-circle"></i> Email delivery</li>
                        <li><i class="bi bi-check2-circle"></i> Read receipts</li>
                        <li><i class="bi bi-check2-circle"></i> Target specific buildings</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Split Showcase Section -->
<section class="section-padding">
    <div class="container">
        <div class="row align-items-center fade-up">
            <div class="col-lg-6 mb-lg-0 pe-lg-5">
                <div class="showcase-content">
                    <h2 class="section-title">Designed for productivity.</h2>
                    <p class="text-muted fs-5 mb-4">
                        We stripped away the clutter to focus on what matters. Fast, responsive, and intuitive—so you spend less time managing software and more time managing properties.
                    </p>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="card-icon icon-blue mb-0" style="width: 48px; height: 48px;">
                            <i class="bi bi-lightning-charge"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 fw-bold">Lightning Fast</h5>
                            <span class="text-muted">Optimized queries and caching ensure near-instant load times.</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="card-icon icon-pink mb-0" style="width: 48px; height: 48px;">
                            <i class="bi bi-phone"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 fw-bold">Mobile Ready</h5>
                            <span class="text-muted">Manage your entire portfolio from your phone or tablet on the go.</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <img src="/images/productivity.png" 
                     alt="Productivity" 
                     class="img-fluid showcase-img" />
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section class="section-padding" id="contact">
    <div class="container fade-up">
        <div class="contact-section shadow-sm">
            <div class="row">
                <div class="col-lg-5 mb-5 mb-lg-0">
                    <div class="contact-info">
                        <h2 class="section-title mb-2">Get in touch</h2>
                        <p class="text-muted mb-5">Have questions about AMS? Drop us a line and we'll get back to you shortly.</p>
                        
                        <div class="contact-item">
                            <div class="contact-icon-wrapper">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold">Email</h6>
                                <span class="text-muted">dabananda.dev@gmail.com</span>
                            </div>
                        </div>
                        <div class="contact-item">
                            <div class="contact-icon-wrapper">
                                <i class="bi bi-whatsapp"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold">WhatsApp</h6>
                                <span class="text-muted">+8801304080014</span>
                            </div>
                        </div>
                        <div class="contact-item">
                            <div class="contact-icon-wrapper">
                                <i class="bi bi-geo-alt"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold">Location</h6>
                                <span class="text-muted">Mirpur 13, Dhaka, Bangladesh</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7 ps-lg-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
                            <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Contact" method="post" class="form-modern needs-validation" novalidate>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Name">Name</label>
                                <input asp-for="Name" class="form-control" placeholder="John Doe" required />
                                <span class="text-danger small" asp-validation-for="Name"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email">Email</label>
                                <input asp-for="Email" class="form-control" placeholder="john@example.com" required />
                                <span class="text-danger small" asp-validation-for="Email"></span>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Subject">Subject</label>
                            <input asp-for="Subject" class="form-control" placeholder="How can we help?" required />
                            <span class="text-danger small" asp-validation-for="Subject"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Message">Message</label>
                            <textarea asp-for="Message" rows="5" class="form-control" placeholder="Tell us more about your needs..." required></textarea>
                            <span class="text-danger small" asp-validation-for="Message"></span>
                        </div>
                        <button class="btn btn-premium w-100" type="submit">
                            <i class="bi bi-send me-2"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Footer -->
<footer class="py-4 border-top bg-white mt-auto text-center">
    <div class="container">
        <p class="text-muted mb-0">&copy; @DateTime.Now.Year Apartment Management System. All rights reserved.</p>
    </div>
</footer>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Navbar Scroll Effect
        window.addEventListener('scroll', function() {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('navbar-scrolled');
            } else {
                navbar.classList.remove('navbar-scrolled');
            }
        });

        // Intersection Observer for Fade-up animations
        document.addEventListener('DOMContentLoaded', function() {
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        // Optional: stop observing once animated
                        // observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.fade-up').forEach(el => {
                observer.observe(el);
            });
            
            // Trigger animation for elements immediately in view (hero)
            setTimeout(() => {
                document.querySelectorAll('.hero-modern .fade-up').forEach(el => {
                    el.classList.add('visible');
                });
            }, 100);
        });

        // Form validation
        (function () {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();

        // Form submission state
        document.querySelector('form').addEventListener('submit', function(e) {
            if (this.checkValidity()) {
                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Sending...';
                submitBtn.disabled = true;

                // Re-enable after 5s if needed (backend handles redirect typically)
                setTimeout(() => {
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }, 5000);
            }
        });
    </script>
}

