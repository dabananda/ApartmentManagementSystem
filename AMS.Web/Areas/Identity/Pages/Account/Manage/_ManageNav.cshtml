@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<style>
    .manage-nav .nav-link {
        color: #495057;
        border-radius: 12px;
        padding: 0.85rem 1.25rem;
        margin-bottom: 0.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
    }
    .manage-nav .nav-link:hover {
        background: #e9ecef;
        color: #1d1d1f;
        transform: translateX(4px);
    }
    .manage-nav .nav-link.active {
        background: linear-gradient(135deg, #5E5CE6 0%, #BF5AF2 100%);
        color: white !important;
        box-shadow: 0 4px 15px rgba(94, 92, 230, 0.3);
        transform: translateX(4px);
    }
    .manage-nav .nav-link i {
        font-size: 1.1rem;
        width: 28px;
        text-align: left;
    }
</style>

<ul class="nav nav-pills flex-column manage-nav">
    <li class="nav-item"><a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index"><i class="bi bi-person"></i> Profile</a></li>
    <li class="nav-item"><a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email"><i class="bi bi-envelope"></i> Email</a></li>
    <li class="nav-item"><a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword"><i class="bi bi-shield-lock"></i> Password</a></li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item"><a id="external-login" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins"><i class="bi bi-link-45deg"></i> External logins</a></li>
    }
    @* <li class="nav-item"><a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication"><i class="bi bi-phone"></i> Two-factor auth</a></li>
    <li class="nav-item"><a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData"><i class="bi bi-download"></i> Personal data</a></li> *@
</ul>
