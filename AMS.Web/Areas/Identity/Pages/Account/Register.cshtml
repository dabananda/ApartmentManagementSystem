@page
@model RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "Register | AMS";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/png" href="https://res.cloudinary.com/djz3p8sux/image/upload/v1786640389/ams/ams_rdxdoy.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #F5F5F7;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-container, .register-container, .forgot-container {
            display: flex;
            max-width: 900px;
            width: 100%;
            background: white;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(94, 92, 230, 0.15);
            border: 1px solid rgba(0,0,0,0.08);
        }

        .welcome-section {
            flex: 1;
            background: linear-gradient(135deg, #5E5CE6 0%, #BF5AF2 100%);
            padding: 60px 50px;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

            .welcome-section::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
                animation: pulse 15s ease-in-out infinite;
            }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 0.5;
            }
            50% {
                transform: scale(1.1);
                opacity: 0.3;
            }
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 40px;
            position: relative;
            z-index: 1;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.25);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .welcome-content {
            position: relative;
            z-index: 1;
        }

            .welcome-content h1 {
                font-size: 3rem;
                font-weight: 800;
                line-height: 1.1;
                margin-bottom: 20px;
                letter-spacing: -0.03em;
            }

            .welcome-content p {
                font-size: 1.1rem;
                line-height: 1.6;
                opacity: 0.9;
                margin-bottom: 30px;
            }

        .view-more-btn {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 12px 30px;
            border-radius: 30px;
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            width: fit-content;
            text-decoration: none;
        }

            .view-more-btn:hover {
                background: rgba(255, 255, 255, 0.3);
                transform: translateY(-2px);
                color: white;
            }

        .form-section {
            flex: 1;
            padding: 60px 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: white;
        }

        .form-card {
            background: white;
            padding: 0;
            border-radius: 0;
            box-shadow: none;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                font-size: 14px;
                color: #1D1D1F;
                margin-bottom: 8px;
                font-weight: 600;
            }

        .form-control {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid #d2d2d7;
            border-radius: 12px;
            font-size: 15px;
            transition: all 0.3s ease;
            background: #ffffff;
        }

            .form-control:focus {
                outline: none;
                border-color: #5E5CE6;
                box-shadow: 0 0 0 4px rgba(94, 92, 230, 0.1);
            }

        .form-check {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }

        .form-check-input {
            width: 18px;
            height: 18px;
            cursor: pointer;
            border-radius: 6px;
            border: 1px solid #d2d2d7;
        }
        
        .form-check-input:checked {
            background-color: #5E5CE6;
            border-color: #5E5CE6;
        }

        .form-check-label {
            font-size: 14px;
            color: #1D1D1F;
            cursor: pointer;
        }

        .forgot-link {
            color: #5E5CE6;
            text-decoration: none;
            font-size: 14px;
            margin-left: auto;
            font-weight: 500;
        }

            .forgot-link:hover {
                text-decoration: underline;
                color: #4e4bdc;
            }

        .login-btn, .signup-btn, button[type="submit"] {
            width: 100%;
            padding: 14px;
            background: #5E5CE6;
            color: white;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            margin-bottom: 20px;
            box-shadow: 0 4px 14px rgba(94, 92, 230, 0.3);
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

            .login-btn:hover, .signup-btn:hover, button[type="submit"]:hover {
                background: #4e4bdc;
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(94, 92, 230, 0.4);
                color: white;
            }

        .signup-section {
            text-align: center;
            margin-top: 20px;
        }

            .signup-section p {
                color: #86868B;
                font-size: 14px;
                margin-bottom: 15px;
            }

        .signup-btn {
            background: transparent;
            color: #1D1D1F;
            border: 1px solid #d2d2d7;
            box-shadow: none;
        }

            .signup-btn:hover {
                background: #F5F5F7;
                border-color: #86868B;
                box-shadow: none;
                color: #1D1D1F;
            }

        .text-danger {
            color: #ff3b30;
            font-size: 13px;
            margin-top: 5px;
            display: block;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alert-danger {
            background-color: #fff0f0;
            border: 1px solid #ffcaca;
            color: #ff3b30;
        }

        @@media (max-width: 768px) {
            .login-container, .register-container, .forgot-container {
                flex-direction: column;
            }

            .welcome-section {
                padding: 40px 30px;
            }

            .welcome-content h1 {
                font-size: 2.5rem;
            }

            .form-section {
                padding: 40px 30px;
            }

            .form-card {
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="welcome-section">
            <div class="logo">
                <div class="logo-icon">
                    <i class="bi bi-building" style="font-size: 20px;"></i>
                </div>
                <span>AMS</span>
            </div>
            <div class="welcome-content">
                <h1>Join Our<br>Community!</h1>
                <p>Create your account and become part of our apartment management system. Easy registration in just a few steps.</p>
                <a href="/Identity/Account/Login" class="login-link-btn text-light">Already have an account?</a>
            </div>
            <div class="wave-decoration"></div>
        </div>

        <div class="form-section">
            <div class="form-card">
                @* <h2>Create Account</h2>
                <p class="subtitle">Fill in your details to get started</p> *@

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Input.Fullname">Full Name</label>
                            <input asp-for="Input.Fullname" class="form-control" placeholder="John Doe" />
                            <span asp-validation-for="Input.Fullname" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.PhoneNumber">Phone Number</label>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+1234567890" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.BuildingCode">Building Code</label>
                        <input asp-for="Input.BuildingCode" class="form-control" placeholder="e.g., BID1001" />
                        <span asp-validation-for="Input.BuildingCode" class="text-danger"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Input.Password">Password</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="••••••••" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="••••••••" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="register-btn">Sign up</button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>


